<% if (error && !order) { %>

  <div class="border border-maroon/40 bg-maroon/5 p-5">
    <p class="font-serif text-lg text-maroon">We couldn’t find that</p>
    <p class="mt-2 text-sm text-muted"><%= error %></p>
    <p class="mt-2 text-xs text-muted">The order number is on your confirmation, in the form <code class="bg-cream px-1">ORD-00042</code>. Coupon orders look like <code class="bg-cream px-1">ORD-C-00042</code>.</p>
  </div>

<% } else { %>

  <%
    const st = orders.statusMeta(order.status);
    const delivered = (order.timeline || []).slice().reverse().find(function (t) { return /delivered/i.test(t.label); });
  %>

  <!-- ------------------------------------------------ order summary ---- -->
  <div class="border border-line">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line bg-cream/40 px-5 py-4">
      <div>
        <p class="font-serif text-lg"><%= order.id %></p>
        <p class="text-xs text-muted">
          Placed <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
          <% if (delivered) { %> · delivered <%= new Date(delivered.at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %><% } %>
        </p>
      </div>
      <div class="flex items-center gap-3">
        <span class="border px-3 py-1.5 text-[10px] uppercase tracking-luxe
          <%= st.tone === 'good' ? 'border-gold text-gold' : (st.tone === 'critical' ? 'border-maroon text-maroon' : 'border-line text-muted') %>"><%= st.label %></span>
        <a href="/order/<%= order.id %>/invoice?print=1&contact=<%= encodeURIComponent(state.contact || '') %>" target="_blank"
           class="border border-line px-3 py-1.5 text-[10px] uppercase tracking-luxe text-muted transition hover:border-maroon hover:text-maroon">Tax invoice</a>
      </div>
    </div>

    <ul class="divide-y divide-line/70 px-5">
      <% order.items.forEach(function (it) { %>
        <li class="flex items-center gap-4 py-3.5">
          <img loading="lazy" src="<%= (catalog.byId(it.productId) || { images: ['/ph.svg?seed=x&w=80&h=100'] }).images[0] %>" alt="" class="h-16 w-12 shrink-0 object-cover">
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm"><%= it.name %></span>
            <span class="block text-xs text-muted"><%= it.size %> · <%= it.color %> · qty <%= it.qty %></span>
          </span>
          <span class="text-sm"><%= money(it.price * it.qty) %></span>
        </li>
      <% }); %>
    </ul>

    <div class="flex items-center justify-between border-t border-line px-5 py-3 text-sm">
      <span class="text-muted">Paid</span>
      <span><%= money(order.total) %></span>
    </div>
    <% if (order.codPlan && order.codPlan.dueOnDelivery && order.paymentStatus !== 'paid') { %>
      <div class="flex items-center justify-between border-t border-line px-5 py-3 text-sm">
        <span class="text-muted">Due on delivery (cash)</span>
        <span class="text-maroon"><%= money(order.codPlan.dueOnDelivery) %></span>
      </div>
    <% } %>
  </div>

  <!-- ------------------------------------------------ existing requests ---- -->
  <% if (existing && existing.length) { %>
    <div class="mt-4 border border-line p-5">
      <p class="text-[10px] uppercase tracking-luxe text-gold">Your return</p>
      <% existing.forEach(function (r) { %>
        <% const rst = returns.statusMeta(r.status); %>
        <div class="mt-3">
          <p class="font-serif text-base"><%= r.id %> · <%= rst.label %></p>
          <p class="mt-1 text-xs text-muted"><%= rst.hint %> · raised <%= new Date(r.requestedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></p>
          <p class="mt-1 text-sm text-muted">Reason: <%= r.reason %></p>
          <% if (r.status === 'refunded') { %>
            <p class="mt-1 text-sm text-maroon"><%= money(r.refundAmount || 0) %> refunded — allow 5–7 working days to appear.</p>
          <% } else { %>
            <p class="mt-1 text-sm text-muted">Expected refund: <%= money(r.requestedAmount) %></p>
          <% } %>
          <ol class="mt-3 space-y-1.5 border-t border-line pt-3">
            <% (r.timeline || []).slice().reverse().forEach(function (t) { %>
              <li class="text-xs text-muted"><%= new Date(t.at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %> — <%= t.label %></li>
            <% }); %>
          </ol>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- ------------------------------------------------ request form ---- -->
  <% if (eligibility && eligibility.ok) { %>
    <form class="mt-4 border border-line p-5"
          hx-post="/returns" hx-target="#returns-panel" hx-swap="innerHTML">
      <input type="hidden" name="orderId" value="<%= order.id %>">
      <input type="hidden" name="contact" value="<%= state.contact || '' %>">

      <p class="text-[10px] uppercase tracking-luxe text-gold">Request a return</p>
      <p class="mt-1 text-xs text-muted">
        Window closes <%= eligibility.deadline.toDateString().slice(4) %>.
      </p>

      <% if (error) { %>
        <p class="mt-3 border border-maroon/40 bg-maroon/5 px-3 py-2 text-xs text-maroon"><%= error %></p>
      <% } %>

      <p class="mt-4 mb-2 text-[10px] uppercase tracking-luxe text-muted">What are you returning?</p>
      <div class="space-y-2">
        <% order.items.forEach(function (it, i) { %>
          <label class="flex cursor-pointer items-center gap-3 border border-line px-3 py-2.5 text-sm has-[:checked]:border-maroon">
            <input type="checkbox" name="items" value="<%= i %>" <%= order.items.length === 1 ? 'checked' : '' %>
                   class="h-[15px] w-[15px] shrink-0 appearance-none border border-line checked:border-maroon checked:bg-maroon">
            <span class="flex-1"><%= it.name %> <span class="text-muted">· <%= it.size %> · qty <%= it.qty %></span></span>
            <span class="text-muted"><%= money(it.price * it.qty) %></span>
          </label>
        <% }); %>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <div>
          <label class="mb-1.5 block text-[10px] uppercase tracking-luxe text-muted" for="reason">Reason</label>
          <select id="reason" name="reason" class="w-full border border-line bg-ivory px-3 py-2.5 text-sm focus:border-maroon focus:outline-none">
            <% returns.REASONS.forEach(function (r) { %><option value="<%= r %>"><%= r %></option><% }); %>
          </select>
        </div>
        <div>
          <label class="mb-1.5 block text-[10px] uppercase tracking-luxe text-muted" for="method">Refund to</label>
          <select id="method" name="method" class="w-full border border-line bg-ivory px-3 py-2.5 text-sm focus:border-maroon focus:outline-none">
            <% returns.METHODS.forEach(function (m) { %><option value="<%= m.id %>"><%= m.label %></option><% }); %>
          </select>
        </div>
      </div>

      <div class="mt-3">
        <label class="mb-1.5 block text-[10px] uppercase tracking-luxe text-muted" for="note">Tell us what happened</label>
        <textarea id="note" name="note" rows="3" placeholder="The blouse runs tight across the shoulders…"
                  class="w-full border border-line bg-ivory px-3 py-2.5 text-sm focus:border-maroon focus:outline-none"></textarea>
      </div>

      <!-- photos help us approve damage claims immediately -->
      <div class="mt-3">
        <p class="mb-1.5 text-[10px] uppercase tracking-luxe text-muted">Photos or video (optional)</p>
        <div hx-post="/uploads/return-media" hx-target="#return-media-list" hx-swap="beforeend"
             hx-encoding="multipart/form-data" hx-indicator="#return-media-busy" hx-trigger="change from:find input[type=file]"
             hx-include="find input[type=file]">
          <label class="flex cursor-pointer items-center justify-between gap-3 border border-dashed border-line px-3 py-3 transition hover:border-maroon">
            <span class="text-xs text-muted">Show us the issue — uploads compress automatically while you finish the form</span>
            <input type="file" name="media" multiple accept="image/*,video/mp4,video/webm,video/quicktime" class="hidden">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="shrink-0 text-gold"><path d="M12 16V4m0 0L8 8m4-4 4 4"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
          </label>
        </div>
        <div id="return-media-busy" class="htmx-indicator mt-2 text-[11px] text-muted">Uploading and compressing…</div>
        <div id="return-media-list" class="mt-2 flex flex-wrap gap-2"></div>
      </div>

      <button class="mt-5 w-full bg-maroon py-3.5 text-[11px] uppercase tracking-luxe text-ivory transition hover:bg-maroonDark">
        <span class="htmx-hide-on-request">Submit return request</span>
        <span class="htmx-show-on-request">Sending…</span>
      </button>
    </form>
  <% } else if (eligibility) { %>
    <div class="mt-4 border border-line bg-cream/40 p-5">
      <p class="font-serif text-base">A return isn’t open on this order</p>
      <p class="mt-2 text-sm text-muted"><%= eligibility.reason %></p>
      <p class="mt-2 text-xs text-muted">
        If something is wrong with the piece, call <a href="tel:<%= config.brand.supportPhone %>" class="text-maroon"><%= config.brand.supportPhone %></a> —
        we look at damage claims outside the window case by case.
      </p>
    </div>
  <% } %>

<% } %>
