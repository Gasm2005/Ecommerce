<% const p = product; %>
<div x-data="{ main: 0, size: '<%= p.sizes[0] %>', color: '<%= p.colors[0] %>' }" class="grid gap-0 sm:grid-cols-2">

  <div class="bg-cream">
    <% p.images.forEach(function (img, i) { %>
      <img src="<%= img %>" alt="<%= p.name %>" loading="lazy" x-show="main === <%= i %>"
           <%= i === 0 ? '' : 'style="display:none"' %>
           class="aspect-[3/4] w-full object-cover">
    <% }); %>
    <div class="flex gap-2 p-3">
      <% p.images.forEach(function (img, i) { %>
        <button type="button" @click="main = <%= i %>" :class="main === <%= i %> ? 'ring-1 ring-maroon' : 'ring-1 ring-line'"
                class="h-16 w-12 overflow-hidden" aria-label="View <%= i + 1 %>">
          <img loading="lazy" src="<%= img %>" alt="" class="h-full w-full object-cover">
        </button>
      <% }); %>
    </div>
  </div>

  <div class="p-6 sm:p-8">
    <% if (p.badge) { %>
      <span class="inline-block bg-cream px-2.5 py-1 text-[9px] uppercase tracking-luxe text-maroon"><%= p.badge %></span>
    <% } %>
    <h2 class="mt-3 font-serif text-2xl leading-tight"><%= p.name %></h2>
    <p class="mt-1 text-sm text-muted"><%= p.subtitle %></p>

    <p class="mt-4 flex items-baseline gap-2">
      <span class="font-serif text-xl"><%= money(p.price) %></span>
      <% if (p.mrp > p.price) { %><span class="text-sm text-muted line-through"><%= money(p.mrp) %></span><% } %>
    </p>

    <p class="mt-5 line-clamp-3 text-sm leading-relaxed text-muted"><%= p.description %></p>

    <p class="mt-6 text-[10px] uppercase tracking-luxe text-muted">Colour · <span class="text-ink" x-text="color"></span></p>
    <div class="mt-2 flex flex-wrap gap-2">
      <% p.colors.forEach(function (c) { %>
        <button type="button" @click="color = '<%= c %>'" :class="color === '<%= c %>' ? 'border-maroon text-ink ring-1 ring-maroon' : 'border-line text-muted'"
                class="inline-flex items-center gap-2 border px-3 py-1.5 text-xs">
          <span class="h-3 w-3 shrink-0 rounded-full ring-1 ring-line" style="background: <%= swatch(c) %>"></span>
          <%= c %>
        </button>
      <% }); %>
    </div>

    <p class="mt-5 text-[10px] uppercase tracking-luxe text-muted">Size</p>
    <div class="mt-2 flex flex-wrap gap-2">
      <% p.sizes.forEach(function (sz) { %>
        <button type="button" @click="size = '<%= sz %>'" :class="size === '<%= sz %>' ? 'border-maroon bg-maroon text-ivory' : 'border-line text-ink'"
                class="min-w-[48px] border px-3 py-2 text-xs"><%= sz %></button>
      <% }); %>
    </div>

    <form id="qv-form-<%= p.id %>" class="mt-7">
      <input type="hidden" name="id" value="<%= p.id %>">
      <input type="hidden" name="size" :value="size">
      <input type="hidden" name="color" :value="color">
      <input type="hidden" name="qty" value="1">
      <button type="button"
              hx-post="/cart/add" hx-include="#qv-form-<%= p.id %>" hx-target="#cart-panel" hx-swap="innerHTML"
              class="w-full bg-maroon py-3.5 text-[11px] uppercase tracking-luxe text-ivory transition hover:bg-maroonDark">
        <span class="htmx-hide-on-request">Add to bag</span>
        <span class="htmx-show-on-request">Adding…</span>
      </button>
    </form>

    <a href="/product/<%= p.slug %>" class="mt-3 block text-center text-[10px] uppercase tracking-luxe text-muted underline underline-offset-4 transition hover:text-maroon">View full details</a>
  </div>
</div>
