<% const c = cartSummary; const added = (typeof justAdded !== 'undefined') ? justAdded : null; %>

<header class="flex items-center justify-between border-b border-line px-5 py-4">
  <h2 class="font-serif text-lg">Shopping Bag <span class="text-[15px] text-muted">(<%= c.count %>)</span></h2>
  <button @click="$store.ui.cart = false" class="p-1 text-2xl leading-none text-muted transition hover:text-maroon" aria-label="Close bag">&times;</button>
</header>

<% if (!c.count) { %>

  <div class="flex flex-1 flex-col items-center justify-center px-8 text-center">
    <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-line"><path d="M6 7h12l1 13H5L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
    <p class="mt-5 font-serif text-xl">Your bag is empty</p>
    <p class="mt-2 text-[15px] text-muted">Start with the pieces our clients keep coming back to.</p>
    <a href="/category/all?sort=popular" @click="$store.ui.cart = false"
       class="mt-6 inline-block bg-maroon px-7 py-3 text-[11px] uppercase tracking-luxe text-ivory transition hover:bg-maroonDark">Shop bestsellers</a>
  </div>

<% } else { %>

  <% if (config.shipping.freeAbove) { %>
    <div class="border-b border-line bg-cream/50 px-5 py-3">
      <% if (c.freeShipEligible) { %>
        <p class="text-[13px] text-maroon">✓ Complimentary shipping unlocked</p>
      <% } else { %>
        <p class="text-[13px] text-muted">Add <span class="text-maroon"><%= money(c.freeShipRemaining) %></span> for free shipping</p>
      <% } %>
      <div class="mt-2 h-[3px] w-full bg-line">
        <div class="h-full bg-gold transition-all duration-500"
             style="width: <%= Math.min(100, Math.round((c.subtotal / config.shipping.freeAbove) * 100)) %>%"></div>
      </div>
    </div>
  <% } %>

  <div class="flex-1 overflow-y-auto px-5">
    <ul class="divide-y divide-line/70">
      <% c.lines.forEach(function (l) { %>
        <li class="flex gap-4 py-4 <%= added === l.product.id ? 'animate-flash' : '' %>">
          <a href="/product/<%= l.product.slug %>" @click="$store.ui.cart = false" class="shrink-0">
            <img loading="lazy" src="<%= l.product.images[0] %>" alt="<%= l.product.name %>" class="h-28 w-20 object-cover">
          </a>

          <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-2">
              <a href="/product/<%= l.product.slug %>" @click="$store.ui.cart = false" class="font-serif text-[15px] leading-snug hover:text-maroon"><%= l.product.name %></a>
              <button hx-post="/cart/remove" hx-vals='<%- JSON.stringify({ key: l.key }) %>'
                      hx-target="#cart-panel" hx-swap="innerHTML"
                      class="shrink-0 text-muted transition hover:text-maroon" aria-label="Remove">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"/></svg>
              </button>
            </div>

            <p class="mt-1 text-[13px] text-muted">
              <%= l.size %><%= l.color ? ' · ' + l.color : '' %>
              <%
                const leftOfThis = variants.stockFor(l.product, { size: l.size, color: l.color });
              %>
              <% if (leftOfThis !== null && l.qty > leftOfThis) { %>
                <span class="mt-0.5 block text-maroon">
                  <%= leftOfThis === 0 ? 'Just sold out' : 'Only ' + leftOfThis + ' left' %>
                </span>
              <% } %>
            </p>

            <div class="mt-3 flex items-center justify-between gap-3">
              <div class="inline-flex items-center border border-line">
                <button hx-post="/cart/update" hx-vals='<%- JSON.stringify({ key: l.key, qty: l.qty - 1 }) %>'
                        hx-target="#cart-panel" hx-swap="innerHTML"
                        class="px-2.5 py-1 text-muted transition hover:text-maroon" aria-label="Decrease quantity">−</button>
                <span class="min-w-[2rem] text-center text-[15px]"><%= l.qty %></span>
                <button hx-post="/cart/update" hx-vals='<%- JSON.stringify({ key: l.key, qty: l.qty + 1 }) %>'
                        hx-target="#cart-panel" hx-swap="innerHTML"
                        class="px-2.5 py-1 text-muted transition hover:text-maroon" aria-label="Increase quantity">+</button>
              </div>
              <span class="text-[15px]"><%= money(l.lineTotal) %></span>
            </div>
          </div>
        </li>
      <% }); %>
    </ul>
  </div>

  <footer class="border-t border-line bg-cream/40 px-5 py-4">

    <!-- coupon -->
    <div class="mb-3 border-b border-line pb-3">
      <% if (c.discountCode) { %>
        <div class="flex items-center justify-between gap-2">
          <p class="text-[13px]">
            <span class="border border-gold/60 bg-gold/10 px-2 py-1 font-mono text-[13.5px] text-ink"><%= c.discountCode %></span>
            <span class="ml-2 text-maroon">− <%= money(c.discount) %></span>
          </p>
          <button hx-post="/cart/coupon/remove" hx-target="#cart-panel" hx-swap="innerHTML"
                  class="text-[10px] uppercase tracking-[0.14em] text-muted transition hover:text-maroon">Remove</button>
        </div>
      <% } else { %>
        <form hx-post="/cart/coupon" hx-target="#cart-panel" hx-swap="innerHTML" class="flex gap-2">
          <input name="code" placeholder="Coupon code" autocomplete="off" spellcheck="false"
                 class="min-w-0 flex-1 border border-line bg-ivory px-3 py-2 text-[13px] uppercase tracking-[0.08em] text-ink placeholder:normal-case placeholder:tracking-normal placeholder:text-muted focus:border-maroon focus:outline-none">
          <button class="shrink-0 border border-ink px-3 py-2 text-[10px] uppercase tracking-[0.14em] text-ink transition hover:border-maroon hover:text-maroon">Apply</button>
        </form>
      <% } %>
      <% const cErr = (typeof couponError !== 'undefined' && couponError) || c.discountError; %>
      <% if (cErr) { %>
        <p class="mt-2 text-[13.5px] text-maroon"><%= cErr %></p>
      <% } %>
    </div>

    <dl class="space-y-1.5 text-[15px]">
      <div class="flex justify-between"><dt class="text-muted">Subtotal</dt><dd><%= money(c.subtotal) %></dd></div>
      <% if (c.discount > 0) { %>
        <div class="flex justify-between"><dt class="text-muted">Coupon <%= c.discountCode %></dt><dd class="text-maroon">− <%= money(c.discount) %></dd></div>
      <% } %>
      <% if (c.savings > 0) { %>
        <div class="flex justify-between"><dt class="text-muted">You save</dt><dd class="text-maroon">− <%= money(c.savings) %></dd></div>
      <% } %>
      <div class="flex justify-between"><dt class="text-muted">Shipping</dt>
        <dd><%= c.shipping ? money(c.shipping) : 'Complimentary' %></dd></div>
      <div class="flex justify-between border-t border-line pt-2 text-base">
        <dt class="font-serif">Total</dt><dd class="font-serif"><%= money(c.total) %></dd></div>
    </dl>

    <a href="/checkout"
       class="mt-4 block bg-maroon py-3.5 text-center text-[11px] uppercase tracking-luxe text-ivory transition hover:bg-maroonDark">
      Proceed to checkout
    </a>
    <div class="mt-2 flex items-center justify-between">
      <a href="/cart" class="text-[11px] uppercase tracking-luxe text-muted transition hover:text-maroon">View full bag</a>
      <button @click="$store.ui.cart = false" class="text-[11px] uppercase tracking-luxe text-muted transition hover:text-maroon">Continue shopping</button>
    </div>
    <% if (config.features.guestCheckout) { %>
      <p class="mt-3 text-center text-[10px] uppercase tracking-[0.14em] text-muted">Guest checkout · no account needed</p>
    <% } %>
  </footer>

<% } %>

<% if (isHx) { %>
  <%- include(view('fragments/cart-badges')) %>
<% } %>
