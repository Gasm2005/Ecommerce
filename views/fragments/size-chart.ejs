<%
  /* Size guide, driven entirely by config.sizeChart.
     A shop selling only womenswear configures one chart and gets no tabs. A shop
     selling to men and women gets a tab each. The measurements were hardcoded
     women's bust/waist/hip before — useless to half the clients this template is
     for.

     `product` is optional: on a product page it selects the matching chart, from
     the footer link it just shows the first. */
  const sc = config.sizeChart || {};
  const charts = Array.isArray(sc.charts) && sc.charts.length ? sc.charts : [{
    id: 'default', label: 'Size',
    columns: ['Size'],
    rows: (((typeof product !== 'undefined' && product) ? product.sizes : null) || ['S', 'M', 'L']).map((s) => [s]),
    notes: []
  }];

  const wanted = (typeof product !== 'undefined' && product && product.sizeChart) || null;
  const found = charts.findIndex((c) => c.id === wanted);
  const startIndex = found >= 0 ? found : 0;
  const many = charts.length > 1;
%>
<div class="p-6 sm:p-9" x-data="{ tab: <%= startIndex %> }">
  <p class="text-[10px] uppercase tracking-luxe text-gold">
    Measurements in <%= sc.unit || 'inches' %>
  </p>
  <h2 class="mt-2 font-serif text-2xl">Size guide</h2>

  <p class="mt-3 max-w-lg text-[15px] text-muted">
    <%= fulfilment.sizeGuideNote(config) %>
  </p>

  <% if (many) { %>
    <!-- Tabs only exist when there is more than one audience to choose between. -->
    <div class="mt-6 flex gap-2 border-b border-line" role="tablist">
      <% charts.forEach(function (c, i) { %>
        <button type="button" role="tab" @click="tab = <%= i %>"
                :class="tab === <%= i %> ? 'border-maroon text-ink' : 'border-transparent text-muted hover:text-ink'"
                class="-mb-px border-b-2 px-3 pb-2.5 text-[11px] uppercase tracking-[0.14em] transition">
          <%= c.label %>
        </button>
      <% }); %>
    </div>
  <% } %>

  <% charts.forEach(function (c, i) { %>
    <div <%- many ? `x-show="tab === ${i}" x-cloak` : '' %>>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[420px] border-collapse text-[15px]">
          <thead>
            <tr class="border-y border-line bg-cream/60 text-left text-[10px] uppercase tracking-[0.14em] text-muted">
              <% (c.columns || []).forEach(function (col) { %>
                <th class="px-3 py-3 font-normal"><%= col %></th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% (c.rows || []).forEach(function (row) { %>
              <tr class="border-b border-line/70">
                <% row.forEach(function (cell, ci) { %>
                  <td class="px-3 py-3 <%= ci === 0 ? 'text-ink' : 'text-muted' %>"><%= cell %></td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="mt-7 grid gap-4 border-t border-line pt-6 text-[15px] text-muted sm:grid-cols-3">
        <% (c.notes || []).forEach(function (n) { %>
          <p><span class="block text-[10px] uppercase tracking-luxe text-gold"><%= n.label %></span><%= n.text %></p>
        <% }); %>
        <p><span class="block text-[10px] uppercase tracking-luxe text-gold">Need help?</span>Call <%= config.brand.supportPhone %>.</p>
      </div>
    </div>
  <% }); %>
</div>
