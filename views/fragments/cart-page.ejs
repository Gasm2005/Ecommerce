<% const c = cartSummary; %>

<% if (!c.count) { %>

  <div class="py-24 text-center">
    <p class="font-serif text-3xl">Your bag is empty</p>
    <p class="mx-auto mt-3 max-w-sm text-sm text-muted">Nothing saved yet. Start with the pieces our clients keep coming back to.</p>
    <a href="/category/all?sort=popular" class="mt-8 inline-block bg-maroon px-8 py-4 text-[11px] uppercase tracking-luxe text-ivory transition hover:bg-maroonDark">Shop bestsellers</a>
  </div>

<% } else { %>

  <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-7">
      <ul class="divide-y divide-line border-y border-line">
        <% c.lines.forEach(function (l) { %>
          <li class="flex gap-4 py-5">
            <a href="/product/<%= l.product.slug %>" class="shrink-0">
              <img loading="lazy" src="<%= l.product.images[0] %>" alt="<%= l.product.name %>" class="h-36 w-26 object-cover" style="width:6.5rem">
            </a>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <a href="/product/<%= l.product.slug %>" class="font-serif text-base hover:text-maroon"><%= l.product.name %></a>
                  <p class="mt-1 text-xs text-muted"><%= l.size %><%= l.color ? ' · ' + l.color : '' %></p>
                <%
                  const leftOfThis = variants.stockFor(l.product, { size: l.size, color: l.color });
                  const short = leftOfThis !== null && l.qty > leftOfThis;
                %>
                <% if (short) { %>
                  <p class="mt-1 text-[12px] text-maroon">
                    <%= leftOfThis === 0 ? 'Just sold out — remove to continue' : 'Only ' + leftOfThis + ' left · reduce the quantity' %>
                  </p>
                <% } %>
                  <p class="mt-1 text-xs text-muted">Ships in <%= l.product.deliveryDays %> days</p>
                </div>
                <p class="shrink-0 text-sm"><%= money(l.lineTotal) %></p>
              </div>

              <div class="mt-4 flex items-center gap-5">
                <div class="inline-flex items-center border border-line">
                  <button hx-post="/cart/update" hx-vals='<%- JSON.stringify({ key: l.key, qty: l.qty - 1, view: 'page' }) %>'
                          hx-target="#cart-page" hx-swap="innerHTML" class="px-3 py-1.5 text-muted hover:text-maroon" aria-label="Decrease">−</button>
                  <span class="min-w-[2.2rem] text-center text-sm"><%= l.qty %></span>
                  <button hx-post="/cart/update" hx-vals='<%- JSON.stringify({ key: l.key, qty: l.qty + 1, view: 'page' }) %>'
                          hx-target="#cart-page" hx-swap="innerHTML" class="px-3 py-1.5 text-muted hover:text-maroon" aria-label="Increase">+</button>
                </div>
                <button hx-post="/cart/remove" hx-vals='<%- JSON.stringify({ key: l.key, view: 'page' }) %>'
                        hx-target="#cart-page" hx-swap="innerHTML"
                        class="text-[10px] uppercase tracking-[0.14em] text-muted underline underline-offset-4 hover:text-maroon">Remove</button>
              </div>
            </div>
          </li>
        <% }); %>
      </ul>

      <a href="/category/all" class="mt-6 inline-block text-[10px] uppercase tracking-[0.14em] text-maroon underline underline-offset-4">Continue shopping</a>
    </div>

    <aside class="lg:col-span-5">
      <div class="lg:sticky lg:top-[190px]">
        <%- include(view('partials/order-summary')) %>
        <a href="/checkout" class="mt-4 block bg-maroon py-4 text-center text-[11px] uppercase tracking-luxe text-ivory transition hover:bg-maroonDark">Proceed to checkout</a>
        <% if (config.features.guestCheckout) { %>
          <p class="mt-2 text-center text-[10px] uppercase tracking-[0.14em] text-muted">Guest checkout · no account needed</p>
        <% } %>
      </div>
    </aside>
  </div>

<% } %>

<% if (isHx) { %>
  <%- include(view('fragments/cart-badges')) %>
<% } %>
