<%- include(view('partials/document-open'), { title: product.name }) %>

<%
  const p = product;
  const ship = config.shipping;

  /* Availability for every size × colour, handed to the page as a small lookup so
     the pickers can react to a colour change without a round trip. `null` means
     untracked — made to order — and must read as available, not as zero.

     Keyed size|colour, lower-cased, because that is how the buttons will ask. */
  const stockMap = {};
  (p.sizes || []).forEach(function (sz) {
    (p.colors && p.colors.length ? p.colors : ['']).forEach(function (c) {
      stockMap[(sz + '|' + c).toLowerCase()] = variants.stockFor(p, { size: sz, color: c });
    });
  });
  const tracked = variants.tracksVariants(p);
  const soldOutEverywhere = !variants.anyAvailable(p);
%>

<div class="mx-auto max-w-[1600px] px-4 lg:px-8">

  <nav class="flex flex-wrap items-center gap-2 pt-6 text-[13.5px] text-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-maroon">Home</a><span>/</span>
    <a href="/category/<%= p.categories[0] %>" class="capitalize hover:text-maroon"><%= p.categories[0] %></a><span>/</span>
    <span class="text-ink"><%= p.name %></span>
  </nav>

  <%
    /* Open on a size that can actually be bought. Landing on a sold-out size and
       finding the buy button dead is a worse first impression than landing on the
       second size. */
    const firstColour = (p.colors && p.colors[0]) || '';
    const openSize = (p.sizes || []).find(function (sz) {
      const n = stockMap[(sz + '|' + firstColour).toLowerCase()];
      return n === null || n > 0;
    }) || (p.sizes || [])[0];
  %>
  <%
    /* The stock map travels in a SINGLE-quoted data attribute, because JSON is full
       of double quotes and inlining it into the double-quoted x-data closed the
       attribute early — Alpine then never initialised and every size looked
       available. Reading it back with JSON.parse keeps the two quote styles apart. */
  %>
  <div data-stock='<%= JSON.stringify(stockMap) %>'
       x-data="{
         size: '<%= openSize %>',
         color: '<%= firstColour %>',
         stock: JSON.parse($el.dataset.stock),
         /* null = untracked, so available. A missing key means the combination is
            not on sale at all. */
         left(sz, c) {
           const key = ((sz === undefined ? this.size : sz) + '|' + (c === undefined ? this.color : c)).toLowerCase();
           const n = this.stock[key];
           return n === undefined ? 0 : n;
         },
         canBuy(sz, c) { const n = this.left(sz, c); return n === null || n > 0; },
         isLow(sz, c) { const n = this.left(sz, c); return n !== null && n > 0 && n <= 2; }
       }"
       id="product-layout"
       class="grid gap-10 py-8 lg:grid-cols-12 lg:gap-12 lg:py-12 xl:gap-16">

    <%- include(view('partials/product-media'), { p: p }) %>

    <!-- ===================== purchase panel (sticky) ===================== -->
    <!-- id is a styling hook: a theme can make this column sticky. -->
    <div id="product-info" class="lg:col-span-5 xl:col-span-4">
      <!-- Not sticky, and deliberately long.
           A short sticky panel meant every other detail had to go into full-width
           sections below, where a paragraph column left ~440px of the page empty.
           Letting this column carry the detail — the way Myntra and Flipkart both
           do — means the images scroll on one side, the words on the other, and no
           band of the page is dead. Add to bag stays reachable via the bar pinned
           to the bottom of the viewport once these buttons scroll away. -->
      <div>

        <h1 class="font-serif text-3xl leading-tight lg:text-[2.5rem]"><%= p.name %></h1>
        <p class="mt-2 text-[15px] text-muted"><%= p.subtitle %></p>

        <div class="mt-5 flex flex-wrap items-baseline gap-3">
          <span class="font-serif text-2xl text-ink"><%= money(p.price) %></span>
          <% if (p.mrp > p.price) { %>
            <span class="text-[15px] text-muted line-through"><%= money(p.mrp) %></span>
            <span class="text-xs uppercase tracking-[0.14em] text-maroon"><%= p.discount %>% off</span>
          <% } %>
        </div>
        <%
          /* The price shown must be the price paid. GST is already inside it — the
             invoice breaks it out, the shopper never has to. The one thing that
             CAN still be added later is delivery, so it is stated here rather than
             appearing as a surprise at checkout.

             The extra line is config copy, not a hardcoded claim: a template that
             promises "duties prepaid" for a client who does not do that is lying
             on their behalf. */
          const freeAbove = ship.freeAbove || 0;
          const deliveryNote = !ship.standardCharge
            ? 'Free delivery'
            : (p.price >= freeAbove
              ? 'Free delivery on this piece'
              : `+ ${money(ship.standardCharge)} delivery, free above ${money(freeAbove)}`);
        %>
        <p class="mt-1 text-[13.5px] text-muted">
          Inclusive of all taxes · <%= deliveryNote %><%
            %><% if (ship.priceNote) { %> · <%= ship.priceNote %><% } %>
        </p>

        <!-- Deliverability before the cart, not after: pincode in, ETA and COD
             out. Same endpoint the checkout uses, so the two can never disagree. -->
        <div class="mt-4 border border-line bg-cream/40 px-3 py-2.5">
          <div class="flex flex-wrap items-end gap-2">
            <div class="min-w-0 flex-1">
              <label class="mb-1 block text-[10px] uppercase tracking-luxe text-muted" for="pdp-pincode">Deliver to</label>
              <input id="pdp-pincode" name="pincode" inputmode="numeric" maxlength="6" placeholder="Enter pincode"
                     hx-post="/product/<%= p.slug %>/deliverability" hx-trigger="keyup changed delay:400ms, change"
                     hx-target="#pdp-delivery" hx-swap="innerHTML"
                     class="w-full border border-line bg-ivory px-3 py-2 text-[15px] focus:border-maroon focus:outline-none">
            </div>
          </div>
          <div id="pdp-delivery" class="mt-1.5 text-[13.5px] leading-relaxed text-muted">
            <%= ship.estimateDaysMetro %>–<%= ship.estimateDaysOther %> working days after dispatch
          </div>
        </div>

        <!-- colour — always shown, even for a single-colourway piece -->
        <div class="mt-7">
          <p class="text-[10px] uppercase tracking-luxe text-muted">Colour · <span class="text-ink" x-text="color"></span></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <% p.colors.forEach(function (c) { %>
              <%
                /* Is this colour available in ANY size? A colour with nothing left
                   is still clickable — the shopper may want to see it — but it says
                   so, so nobody picks it and then wonders why every size is dead. */
                const anySize = (p.sizes || []).some(function (sz) {
                  const n = stockMap[(sz + '|' + c).toLowerCase()];
                  return n === null || n > 0;
                });
              %>
              <button type="button" @click="color = '<%= c %>'"
                      :class="color === '<%= c %>' ? 'border-maroon text-ink ring-1 ring-maroon' : 'border-line text-muted'"
                      class="inline-flex items-center gap-2 border px-3.5 py-2 text-[13px] transition hover:border-gold">
                <span class="h-3.5 w-3.5 shrink-0 rounded-full ring-1 ring-line" style="background: <%= swatch(c) %>"></span>
                <span <%= anySize ? '' : 'class="line-through decoration-1"' %>><%= c %></span>
                <% if (!anySize) { %><span class="text-[10px] uppercase tracking-[0.1em] text-muted">Out</span><% } %>
              </button>
            <% }); %>
          </div>
        </div>

        <!-- size -->
        <div class="mt-6">
          <div class="flex items-center justify-between">
            <p class="text-[10px] uppercase tracking-luxe text-muted">Size · <span class="text-ink" x-text="size"></span></p>
            <button type="button" class="text-[10px] uppercase tracking-[0.14em] text-maroon underline underline-offset-4"
                    @click="$store.ui.openQuick()"
                    hx-get="/fragments/size-chart?product=<%= p.slug %>" hx-target="#quick-body" hx-swap="innerHTML">Size guide</button>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <% p.sizes.forEach(function (sz) { %>
              <%
                /* A sold-out size is disabled and struck through rather than hidden.
                   Hiding it makes a shop look like it never stocked that size; showing
                   it struck through tells the truth and invites a "notify me" later. */
              %>
              <button type="button" @click="size = '<%= sz %>'"
                      :disabled="!canBuy('<%= sz %>')"
                      :title="canBuy('<%= sz %>') ? '' : 'Sold out in this colour'"
                      :class="!canBuy('<%= sz %>')
                        ? 'border-line/60 text-muted/50 line-through decoration-1 cursor-not-allowed'
                        : (size === '<%= sz %>' ? 'border-maroon bg-maroon text-ivory' : 'border-line text-ink hover:border-gold')"
                      class="min-w-[52px] border px-3.5 py-2.5 text-[13px] transition"><%= sz %></button>
            <% }); %>
          </div>

          <!-- Urgency only when it is true: two or fewer of the exact variant. -->
          <p x-show="isLow()" x-cloak class="mt-2.5 text-[13px] text-maroon">
            Only <span x-text="left()"></span> left in <span x-text="size"></span><span
              x-show="color"> · <span x-text="color"></span></span>
          </p>
          <p x-show="!canBuy()" x-cloak class="mt-2.5 text-[13px] text-muted">
            <span x-text="size"></span> is sold out<span x-show="color"> in <span x-text="color"></span></span>.
            Try another size, or call <%= config.brand.supportPhone %>.
          </p>
          <%
            /* Only claimed when the shop actually does it. A retail store selling
               ready-made kurtis promises nothing here. */
            const sizeNote = fulfilment.sizeNote(config);
          %>
          <% if (sizeNote) { %>
            <p class="mt-3 text-[13.5px] text-muted"><%= sizeNote %></p>
          <% } %>
        </div>

        <!-- add to cart -->
        <form id="atc-form" class="mt-7 flex gap-3">
          <input type="hidden" name="id" value="<%= p.id %>">
          <input type="hidden" name="size" :value="size">
          <input type="hidden" name="color" :value="color">
          <input type="hidden" name="qty" value="1">

          <!-- id is the anchor the sticky bar watches: while this button is on
               screen the bar stays hidden, so the page is never wearing two of
               the same control at once. -->
          <%
            /* Disabled when the chosen variant has nothing left. The server refuses
               it anyway — the cart cap is enforced there because anyone can POST —
               but a button that looks alive and then does nothing is the worse
               failure. */
          %>
          <button type="button" id="atc-main"
                  hx-post="/cart/add" hx-include="#atc-form" hx-target="#cart-panel" hx-swap="innerHTML"
                  :disabled="!canBuy()"
                  :class="canBuy()
                    ? 'bg-maroon text-ivory hover:bg-maroonDark'
                    : 'bg-line text-muted cursor-not-allowed'"
                  class="relative flex-1 py-4 text-[11px] uppercase tracking-luxe transition">
            <span x-show="canBuy()" class="htmx-hide-on-request">Add to bag</span>
            <span x-show="canBuy()" class="htmx-show-on-request">Adding…</span>
            <span x-show="!canBuy()" x-cloak>Sold out</span>
          </button>

          <% if ((config.features.wishlist && hasFeature('wishlist'))) { %>
            <%- include(view('fragments/wishlist-button'), { product: p, variant: 'pdp' }) %>
          <% } %>
        </form>

        <button type="button" x-show="canBuy()"
                hx-post="/cart/add" hx-include="#atc-form" hx-target="#cart-panel" hx-swap="innerHTML"
                hx-on:htmx:after-request="window.location.href='/checkout'"
                class="mt-3 w-full border border-ink py-4 text-[11px] uppercase tracking-luxe text-ink transition hover:border-maroon hover:text-maroon">
          Buy now
        </button>

        <!-- delivery / assurance -->
        <div class="mt-7 divide-y divide-line border-y border-line text-[15px]">
          <div class="flex items-start gap-3 py-3.5">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="mt-0.5 shrink-0 text-gold"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
            <%
              /* One place decides whether this piece is made to order: the shop's
                 model AND this product's make time. A retail shop never sees the
                 stitching language, however long deliveryDays says. */
              const promise = fulfilment.deliveryPromise(p, config);
            %>
            <p><strong class="font-medium"><%= promise.lead %></strong> — <%= promise.text %></p>
          </div>
          <div class="flex items-start gap-3 py-3.5">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="mt-0.5 shrink-0 text-gold"><path d="M4 9h16M4 9l1.5 10h13L20 9M8 9V6a4 4 0 0 1 8 0v3"/></svg>
            <p><%= ship.returnWindowDays %>-day return on unaltered pieces<%= ship.codAvailable ? ' · Cash on delivery available' : '' %></p>
          </div>
          <div class="flex items-start gap-3 py-3.5">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="mt-0.5 shrink-0 text-gold"><path d="M12 21a9 9 0 1 0-9-9v4a2 2 0 0 0 2 2h2v-5H5"/><path d="M17 12v5h-2"/></svg>
            <p>Need help? Call <a href="tel:<%= config.brand.supportPhone %>" class="text-maroon"><%= config.brand.supportPhone %></a> or book a video styling call.</p>
          </div>
        </div>

        <!-- ===================== the details, in this column =====================
             Accordions on phone (where vertical space is the scarce thing), plain
             labelled blocks on desktop (where the words should just be readable). -->
        <%
          const acc = [
            { k: 'desc', label: 'Product details', body: p.description },
            { k: 'fabric', label: 'Fabric & craft', body: p.fabricDetails },
            { k: 'care', label: 'Care & delivery',
              body: p.care + ' '
                + (fulfilment.isMadeToOrder(p, config) ? 'Made to order in ' + p.deliveryDays + ' days.' : 'Ready to ship.')
                + ' ' + ship.returnWindowDays + '-day return'
                + (fulfilment.flags(config).customisation ? ' on unaltered pieces.' : '.') }
          ];
        %>
        <div class="mt-9" x-data="{ open: 'desc' }">
          <% acc.forEach(function (a) { %>
            <div class="border-b border-line lg:border-0 lg:mb-7">
              <button type="button" @click="open = open === '<%= a.k %>' ? null : '<%= a.k %>'"
                      class="flex w-full items-center justify-between py-4 text-left text-[11px] uppercase tracking-[0.14em] text-gold lg:pointer-events-none lg:py-0">
                <%= a.label %>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     :class="open === '<%= a.k %>' ? 'rotate-45' : ''" class="transition lg:hidden"><path d="M12 5v14M5 12h14"/></svg>
              </button>
              <div :class="open === '<%= a.k %>' ? 'block' : 'hidden lg:block'">
                <p class="pb-5 text-[15px] leading-relaxed text-muted lg:pb-0 lg:pt-2.5"><%= a.body %></p>
              </div>
            </div>
          <% }); %>

          <!-- Specifications: two columns of short facts, the way a shopper scans
               them. Only the fields this product actually has. -->
          <%
            const specs = [
              ['Fabric', p.fabric],
              ['Occasion', (p.occasion || []).join(', ')],
              ['Colours', (p.colors || []).join(', ')],
              ['Sizes', (p.sizes || []).join(', ')],
              ['SKU', p.sku || p.id],
              ['Made in', (config.business && config.business.state) || null]
            ].filter(function (row) { return row[1]; });
          %>
          <div class="mt-7 border-t border-line pt-6">
            <p class="text-[11px] uppercase tracking-[0.14em] text-gold">Specifications</p>
            <dl class="mt-3 grid grid-cols-2 gap-x-8 gap-y-4">
              <% specs.forEach(function (row) { %>
                <div>
                  <dt class="text-[13px] text-muted"><%= row[0] %></dt>
                  <dd class="mt-0.5 border-b border-line pb-2 text-[14.5px] text-ink"><%= row[1] %></dd>
                </div>
              <% }); %>
            </dl>
          </div>

          <button type="button" class="mt-6 text-[11px] uppercase tracking-[0.14em] text-maroon underline underline-offset-4"
                  @click="$store.ui.openQuick()"
                  hx-get="/fragments/size-chart?product=<%= p.slug %>" hx-target="#quick-body" hx-swap="innerHTML">View size guide</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================ reviews ============================ -->
  <section class="border-t border-line py-12 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div>
        <p class="text-[10px] uppercase tracking-luxe text-gold">Client reviews</p>
        <h2 class="mt-2 font-serif text-2xl lg:text-3xl">
          <% if (reviewStats.count) { %>
            <%= reviewStats.average %> <span class="text-gold">★</span>
          <% } else { %>
            No reviews yet
          <% } %>
        </h2>
        <% if (reviewStats.count) { %>
          <p class="mt-1 text-[15px] text-muted">from <%= reviewStats.count %> verified <%= reviewStats.count === 1 ? 'buyer' : 'buyers' %></p>
          <ul class="mt-5 space-y-1.5">
            <% [5, 4, 3, 2, 1].forEach(function (star) { %>
              <% const n = reviewStats.histogram[star - 1]; const pct = reviewStats.count ? (n / reviewStats.count) * 100 : 0; %>
              <li class="flex items-center gap-3 text-[13px]">
                <span class="w-6 text-muted"><%= star %>★</span>
                <span class="h-[5px] flex-1 bg-cream"><span class="block h-full bg-gold" style="width: <%= pct.toFixed(0) %>%"></span></span>
                <span class="w-6 text-right text-muted"><%= n %></span>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="mt-2 text-[15px] text-muted">Be the first to write one — reviews are checked before they appear.</p>
        <% } %>

        <div id="review-form-slot" class="mt-7">
          <%- include(view('fragments/review-form'), { product: p, reason: null, state: {}, keptMedia: [] }) %>
        </div>
      </div>

      <div class="lg:col-span-2">
        <% if (!reviewList.length) { %>
          <p class="border border-line bg-cream/40 p-6 text-[15px] text-muted">
            No published reviews for this piece yet.
          </p>
        <% } %>
        <ul class="divide-y divide-line">
          <% reviewList.slice(0, 8).forEach(function (r) { %>
            <li class="py-5 first:pt-0">
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-gold"><%= '★'.repeat(r.rating) %><span class="text-line"><%= '★'.repeat(5 - r.rating) %></span></span>
                <span class="font-serif text-base"><%= r.title %></span>
                <% if (r.verified) { %>
                  <span class="border border-line px-2 py-0.5 text-[9px] uppercase tracking-luxe text-muted">Verified buyer</span>
                <% } %>
              </div>
              <p class="mt-2 text-[15px] leading-relaxed text-muted"><%= r.body %></p>

              <% if (r.media && r.media.length) { %>
                <ul class="mt-3 flex flex-wrap gap-2">
                  <% r.media.forEach(function (m) { %>
                    <li>
                      <% if (m.type === 'video') { %>
                        <video src="<%= m.src %>" controls preload="metadata"
                               class="h-28 w-20 bg-cream object-cover sm:h-32 sm:w-24"></video>
                      <% } else { %>
                        <a href="<%= m.src %>" target="_blank" rel="noopener">
                          <img src="<%= m.src %>" alt="Customer photo" loading="lazy"
                               class="h-28 w-20 bg-cream object-cover transition hover:opacity-90 sm:h-32 sm:w-24">
                        </a>
                      <% } %>
                    </li>
                  <% }); %>
                </ul>
              <% } %>

              <p class="mt-2 text-[10px] uppercase tracking-luxe text-muted">
                <%= r.author %><%= r.location ? ' · ' + r.location : '' %> ·
                <%= new Date(r.createdAt).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }) %>
              </p>
              <% if (r.reply) { %>
                <div class="mt-3 border-l-2 border-gold/50 pl-4">
                  <p class="text-[10px] uppercase tracking-luxe text-gold">Response from <%= config.brand.name %></p>
                  <p class="mt-1 text-[15px] leading-relaxed text-muted"><%= r.reply.body %></p>
                </div>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================== FAQs ============================== -->
  <% if (faqs.length) { %>
    <section class="border-t border-line py-12 lg:py-16" x-data="{ open: 0 }">
      <p class="text-[10px] uppercase tracking-luxe text-gold">Questions</p>
      <h2 class="mt-2 font-serif text-2xl lg:text-3xl">Before you order</h2>
      <%
        /* Two columns from lg. A max-w-3xl list left 439px of the page empty on a
           1280 screen — that is dead space, not white space: it reads as a page
           that failed to load rather than a page with room to breathe. */
      %>
      <div class="mt-7 lg:grid lg:grid-cols-2 lg:gap-x-14">
        <% faqs.forEach(function (f, i) { %>
          <div class="border-b border-line">
            <button type="button" @click="open = open === <%= i %> ? null : <%= i %>"
                    class="flex w-full items-center justify-between gap-4 py-4 text-left text-[15px]">
              <span class="text-ink"><%= f.q %></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   :class="open === <%= i %> ? 'rotate-45' : ''" class="shrink-0 text-muted transition"><path d="M12 5v14M5 12h14"/></svg>
            </button>
            <div x-show="open === <%= i %>" x-collapse>
              <p class="pb-5 text-[15px] leading-relaxed text-muted"><%= f.a %></p>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>

  <!-- ========================= you may also like ========================= -->
  <% if (related.length) { %>
    <!-- id is watched by the sticky buy bar: once the shopper is looking at OTHER
         pieces, a bar for THIS one is noise, and worse, a mis-click. -->
    <section id="upsell" class="border-t border-line py-14 lg:py-20"
             x-data="{ atStart: true, atEnd: false,
                       sync() { const r = $refs.rail; this.atStart = r.scrollLeft < 8; this.atEnd = r.scrollLeft + r.clientWidth >= r.scrollWidth - 8; } }"
             x-init="$nextTick(() => sync())">
      <div class="flex items-end justify-between">
        <div>
          <p class="text-[10px] uppercase tracking-luxe text-gold">Curated for you</p>
          <h2 class="mt-2 font-serif text-2xl lg:text-3xl">You may also like</h2>
        </div>
        <div class="hidden gap-2 lg:flex">
          <button type="button" @click="$refs.rail.scrollBy({ left: -$refs.rail.clientWidth * 0.8, behavior: 'smooth' })"
                  :class="atStart ? 'opacity-30' : 'hover:border-maroon hover:text-maroon'"
                  class="flex h-10 w-10 items-center justify-center border border-line transition" aria-label="Previous">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button type="button" @click="$refs.rail.scrollBy({ left: $refs.rail.clientWidth * 0.8, behavior: 'smooth' })"
                  :class="atEnd ? 'opacity-30' : 'hover:border-maroon hover:text-maroon'"
                  class="flex h-10 w-10 items-center justify-center border border-line transition" aria-label="Next">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <ul id="rail-related" x-ref="rail" @scroll.passive="sync()"
          class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain pb-2 no-scrollbar lg:snap-none lg:gap-6">
        <% related.forEach(function (r) { %>
          <li class="w-[58%] shrink-0 snap-start sm:w-[38%] lg:w-[23%]">
            <%- include(view('partials/product-card'), { product: r }) %>
          </li>
        <% }); %>
      </ul>
    </section>
  <% } %>
</div>

<!-- ============ mobile/tablet sticky buy bar (sits above the tab bar) ============ -->
<!-- =========================== sticky buy bar ===========================
     Both actions stay reachable however far the page is scrolled — on a page this
     long, hunting back up for the button is the commonest reason a ready buyer
     doesn't buy.

     On phone it is always there (above the app tab bar). On desktop it appears
     only once the real buttons have scrolled out of view, watched with an
     IntersectionObserver rather than a scroll listener, so there is no work on
     every scroll frame. -->
<%
  /* The bar keeps its own `size`: the picker's Alpine scope is the product grid,
     which this bar sits outside of. It reads the hidden input the picker already
     writes to — one source of truth, no second copy of the selection logic. */
%>
<%
  /* Measured on scroll rather than with an IntersectionObserver: an observer set
     up inside x-init did not reliably reach this component's reactive state from
     its callback, and the bar silently never appeared. A throttled read of two
     bounding rects is a few microseconds and is obvious to reason about. */
%>
<div data-stock='<%= JSON.stringify(stockMap) %>'
     x-data="{
       past: false,
       upsell: false,
       size: '<%= openSize %>',
       color: '<%= firstColour %>',
       /* Its own copy of the map: this bar is a separate Alpine scope, and without
          it the bar offered a size the buttons above had already refused. */
       stock: JSON.parse($el.dataset.stock),
       left(sz, c) { const v = this.stock[(sz + '|' + c).toLowerCase()]; return v === undefined ? null : v; },
       canBuy() { const n = this.left(this.size, this.color); return n === null || n > 0; },
       /* Visible when this piece is still what the page is about AND the real buttons
          have scrolled away — on every width.

          This used to add `|| window.innerWidth < 1024`, on the theory that a phone
          scrolls past the buttons immediately anyway. It does not: the size picker and
          Add to bag sit mid-page, so on a phone the bar appeared while the real button
          was still on screen and the page showed TWO Add to bag buttons at once. Which
          one is the live one is not a question to make a customer answer.

          `past` already handles the phone correctly — it is true the moment #atc-main
          leaves the top of the viewport, which on a phone is very soon. */
       get visible() { return !this.upsell && this.past; },
       measure() {
         const main = document.getElementById('atc-main');
         if (main) this.past = main.getBoundingClientRect().bottom < 70;
         const up = document.getElementById('upsell');
         // 'Started browsing other pieces' = the upsell is a fifth of the way in,
         // not merely one pixel over the edge.
         this.upsell = up ? up.getBoundingClientRect().top < window.innerHeight * 0.8 : false;
         this.readSize();
       },
       readSize() {
         const sz = document.querySelector('#atc-form input[name=size]');
         const c = document.querySelector('#atc-form input[name=color]');
         if (sz) this.size = sz.value;
         if (c) this.color = c.value;
       }
     }"
     x-init="measure()"
     @scroll.window.throttle.100ms="measure()"
     @resize.window.throttle.200ms="measure()"
     @click.window="$nextTick(() => readSize())"
     @htmx:after-settle.window="readSize()"
     x-show="visible"
     x-transition.opacity
     class="fixed inset-x-0 bottom-[calc(4.4rem+env(safe-area-inset-bottom))] z-[71] border-t border-line bg-ivory/95 backdrop-blur lg:bottom-0">
  <div class="mx-auto flex max-w-[1600px] items-center gap-3 px-4 py-3 lg:px-8">
    <img src="<%= p.images[0] %>" alt="" class="hidden h-12 w-9 shrink-0 object-cover lg:block">
    <div class="min-w-0 flex-1">
      <p class="truncate font-serif text-[15px]"><%= p.name %></p>
      <p class="text-[15px] text-ink">
        <%= money(p.price) %>
        <% if (p.mrp > p.price) { %><span class="ml-1 text-[13px] text-muted line-through"><%= money(p.mrp) %></span><% } %>
        <span class="ml-1 hidden text-[12.5px] text-muted lg:inline">incl. taxes</span>
      </p>
    </div>

    <!-- Size is echoed here because at this scroll depth the picker is long gone
         and "which size am I buying?" is a fair question to be able to answer. -->
    <p class="hidden shrink-0 text-[12.5px] text-muted lg:block">
      Size <span class="text-ink" x-text="size"></span>
    </p>

    <button type="button"
            x-show="canBuy()"
            hx-post="/cart/add" hx-include="#atc-form" hx-target="#cart-panel" hx-swap="innerHTML"
            hx-on:htmx:after-request="window.location.href='/checkout'"
            class="hidden shrink-0 border border-ink px-7 py-3.5 text-[11px] uppercase tracking-luxe text-ink transition hover:border-maroon hover:text-maroon lg:block">
      Buy now
    </button>

    <!-- Two buttons rather than one that changes label: a live control and a dead
         one should not share an element, or a mid-swap click still posts. -->
    <button type="button"
            x-show="canBuy()"
            hx-post="/cart/add" hx-include="#atc-form" hx-target="#cart-panel" hx-swap="innerHTML"
            class="shrink-0 bg-maroon px-7 py-3.5 text-[11px] uppercase tracking-luxe text-ivory transition hover:bg-maroonDark">
      Add to bag
    </button>
    <button type="button" disabled x-show="!canBuy()" x-cloak
            class="shrink-0 cursor-not-allowed border border-line px-7 py-3.5 text-[11px] uppercase tracking-luxe text-muted">
      Sold out<span class="hidden lg:inline"> in <span x-text="size"></span></span>
    </button>
  </div>
</div>
<div class="h-16 lg:hidden"></div>

<%- include(view('partials/document-close')) %>
