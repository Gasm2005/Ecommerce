<%- include(view('partials/document-open'), { title: 'Returns & refunds' }) %>

<div class="mx-auto max-w-3xl px-4 lg:px-8">
  <header class="border-b border-line py-10 text-center lg:py-14">
    <p class="text-[10px] uppercase tracking-luxe text-gold">Client care</p>
    <h1 class="mt-3 font-serif text-3xl lg:text-4xl">Returns & refunds</h1>
    <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted">
      Unaltered pieces can be returned within <%= config.shipping.returnWindowDays %> days of delivery.
      Enter your order number to check the status or raise a return — no account needed.
    </p>
  </header>

  <% if (invoiceWanted) { %>
    <p class="mt-4 border border-gold/40 bg-gold/5 px-4 py-3 text-xs text-muted">
      To download the tax invoice for <strong class="text-ink"><%= invoiceWanted %></strong>, confirm the
      email or phone used on the order.
    </p>
  <% } %>

  <% if (orderWanted) { %>
    <!-- Say why they were sent here. A privacy check with no explanation reads as a bug. -->
    <p class="mt-4 border border-gold/40 bg-gold/5 px-4 py-3 text-xs text-muted">
      <strong class="text-ink"><%= orderWanted %></strong> wasn’t placed from this device, so we ask for the
      email or phone on the order before showing it. It keeps your order private from anyone who guesses a
      number.
    </p>
  <% } %>

  <form class="py-8" hx-post="/returns/lookup" hx-target="#returns-panel" hx-swap="innerHTML">
    <div class="grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
      <div>
        <label class="mb-1.5 block text-[10px] uppercase tracking-luxe text-muted" for="orderId">Order number</label>
        <input id="orderId" name="orderId" required placeholder="ORD-00042" value="<%= orderWanted || invoiceWanted %>"
               class="w-full border border-line bg-ivory px-4 py-3 text-sm uppercase focus:border-maroon focus:outline-none">
      </div>
      <div>
        <label class="mb-1.5 block text-[10px] uppercase tracking-luxe text-muted" for="contact">Email or phone</label>
        <input id="contact" name="contact" required placeholder="As used on the order"
               class="w-full border border-line bg-ivory px-4 py-3 text-sm focus:border-maroon focus:outline-none">
      </div>
      <button class="mt-auto bg-maroon px-7 py-3.5 text-[11px] uppercase tracking-luxe text-ivory transition hover:bg-maroonDark">
        <span class="htmx-hide-on-request">Find order</span>
        <span class="htmx-show-on-request">Checking…</span>
      </button>
    </div>
  </form>

  <div id="returns-panel" class="pb-16"></div>

  <section class="border-t border-line py-10">
    <h2 class="font-serif text-xl">The policy, plainly</h2>
    <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-muted">
      <li>· <%= config.shipping.returnWindowDays %> days from delivery on unaltered, unworn pieces with tags intact.</li>
      <li>· Customised and altered garments are final sale — the measurements were cut for you.</li>
      <li>· Refunds go back to the original payment method within 5–7 working days of us receiving the piece.</li>
      <li>· Damaged or wrong deliveries are picked up at our cost — send photos with the request and we'll prioritise it.</li>
      <li>· Questions first? Call <a href="tel:<%= config.brand.supportPhone %>" class="text-maroon"><%= config.brand.supportPhone %></a>.</li>
    </ul>
  </section>
</div>

<%- include(view('partials/document-close')) %>
