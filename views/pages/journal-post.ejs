<%- include(view('partials/document-open'), { title: post.title }) %>

<article class="mx-auto max-w-[820px] px-4 lg:px-8">
  <nav class="flex items-center gap-2 pt-6 text-[11px] text-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-maroon">Home</a><span>/</span>
    <a href="/journal" class="hover:text-maroon">Journal</a><span>/</span>
    <span class="truncate text-ink"><%= post.title %></span>
  </nav>

  <header class="pt-8 text-center lg:pt-12">
    <p class="text-[10px] uppercase tracking-luxe text-gold">
      <%= (post.tags || []).join(' · ') || 'Journal' %>
    </p>
    <h1 class="mx-auto mt-4 max-w-2xl font-serif text-3xl leading-tight lg:text-[2.75rem]"><%= post.title %></h1>
    <p class="mt-4 text-[11px] uppercase tracking-luxe text-muted">
      <%= post.author %> ·
      <%= new Date(post.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %> ·
      <%= post.readingMinutes %> min read
    </p>
  </header>

  <div class="mt-8 overflow-hidden bg-cream lg:mt-10">
    <img src="<%= post.cover || ('/ph.svg?seed=jrn' + post.slug + '&w=1400&h=800&kind=hero&label=' + encodeURIComponent(post.title.slice(0, 30))) %>"
         alt="<%= post.title %>" class="aspect-[7/4] w-full object-cover" fetchpriority="high">
  </div>

  <div class="py-10 lg:py-14">
    <p class="font-serif text-xl leading-relaxed text-ink lg:text-[1.4rem]"><%= post.excerpt %></p>
    <div class="mt-8 space-y-6">
      <% paragraphs.forEach(function (para) { %>
        <p class="text-[15px] leading-[1.85] text-muted"><%= para %></p>
      <% }); %>
    </div>

    <div class="mt-12 border-y border-line py-6 text-center">
      <p class="text-[10px] uppercase tracking-luxe text-gold">Made to order</p>
      <p class="mt-2 font-serif text-xl">Every piece is stitched to your measurements</p>
      <a href="/category/all" class="mt-5 inline-block bg-maroon px-8 py-4 text-[11px] uppercase tracking-luxe text-ivory transition hover:bg-maroonDark">Shop the collection</a>
    </div>
  </div>

  <% if (related.length) { %>
    <section class="border-t border-line py-10 lg:py-14">
      <h2 class="text-center font-serif text-2xl">Keep reading</h2>
      <ul class="mt-8 grid gap-8 sm:grid-cols-3">
        <% related.forEach(function (r) { %>
          <li>
            <a href="/journal/<%= r.slug %>" class="group block">
              <div class="overflow-hidden bg-cream">
                <img loading="lazy" src="<%= r.cover || ('/ph.svg?seed=jrn' + r.slug + '&w=600&h=450&label=' + encodeURIComponent((r.tags || [])[0] || 'Journal')) %>"
                     alt="<%= r.title %>" class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-105">
              </div>
              <p class="mt-3 font-serif text-base leading-snug transition group-hover:text-maroon"><%= r.title %></p>
              <p class="mt-1 text-[10px] uppercase tracking-luxe text-muted"><%= r.readingMinutes %> min read</p>
            </a>
          </li>
        <% }); %>
      </ul>
    </section>
  <% } %>
</article>

<%- include(view('partials/document-close')) %>
