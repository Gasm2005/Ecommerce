<% const a = analysis; %>

<% if (a.parseError) { %>

  <div class="border border-maroon/40 bg-maroon/5 p-5">
    <p class="font-serif text-lg text-maroon">Couldn’t read that file</p>
    <p class="mt-2 font-mono text-xs text-ink"><%= a.parseError %></p>
    <p class="mt-3 text-xs text-muted">If it’s a spreadsheet, export as CSV (UTF-8) and try again.</p>
  </div>

<% } else if (!a.rows.length) { %>

  <div class="border border-line bg-cream/40 p-5">
    <p class="font-serif text-lg">No rows found</p>
    <p class="mt-2 text-xs text-muted">The file needs a header row plus at least one product row.</p>
  </div>

<% } else { %>

  <div class="border border-line">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-3 border-b border-line bg-cream/40 px-5 py-4">
      <div>
        <p class="text-[10px] uppercase tracking-luxe text-gold">Rows read</p>
        <p class="mt-1 font-serif text-xl"><%= a.counts.total %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-luxe text-gold">New</p>
        <p class="mt-1 font-serif text-xl text-ink"><%= a.counts.create %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-luxe text-gold">Updates</p>
        <p class="mt-1 font-serif text-xl text-ink"><%= a.counts.update %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-luxe text-gold">Skipped</p>
        <p class="mt-1 font-serif text-xl <%= a.counts.skip ? 'text-maroon' : 'text-ink' %>"><%= a.counts.skip %></p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-luxe text-gold">Mode</p>
        <p class="mt-1 text-sm capitalize"><%= a.mode %></p>
      </div>
    </div>

    <% if (a.unknownColumns.length) { %>
      <p class="border-b border-line bg-gold/10 px-5 py-3 text-xs text-ink">
        Ignored unknown column<%= a.unknownColumns.length > 1 ? 's' : '' %>:
        <span class="font-mono"><%= a.unknownColumns.join(', ') %></span>
      </p>
    <% } %>

    <div class="max-h-[26rem] overflow-auto">
      <table class="w-full min-w-[860px] border-collapse text-xs">
        <thead class="sticky top-0 bg-ivory">
          <tr class="border-b border-line text-left text-[10px] uppercase tracking-[0.12em] text-muted">
            <th class="px-4 py-3 font-normal">Line</th>
            <th class="px-4 py-3 font-normal">Action</th>
            <th class="px-4 py-3 font-normal">Product</th>
            <th class="px-4 py-3 font-normal">Price</th>
            <th class="px-4 py-3 font-normal">Categories</th>
            <th class="px-4 py-3 font-normal">Notes</th>
          </tr>
        </thead>
        <tbody>
          <% a.rows.forEach(function (r) { %>
            <tr class="border-b border-line/60 align-top <%= r.errors.length ? 'bg-maroon/5' : '' %>">
              <td class="px-4 py-3 text-muted"><%= r.line %></td>
              <td class="px-4 py-3">
                <span class="whitespace-nowrap border px-2 py-0.5 text-[10px] uppercase tracking-[0.1em]
                  <%= r.action === 'create' ? 'border-gold text-gold'
                     : (r.action === 'update' ? 'border-ink text-ink' : 'border-maroon text-maroon') %>"><%= r.action %></span>
              </td>
              <td class="px-4 py-3">
                <span class="block text-ink"><%= r.product.name || '—' %></span>
                <span class="block font-mono text-[10px] text-muted"><%= r.product.slug %> · <%= r.product.id || '—' %></span>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <%= Number.isFinite(r.product.price) ? money(r.product.price) : '<span class="text-maroon">invalid</span>' %>
              </td>
              <td class="px-4 py-3 text-muted"><%= r.product.categories.join(', ') || '—' %></td>
              <td class="px-4 py-3">
                <% r.errors.forEach(function (e) { %>
                  <span class="block text-maroon">✕ <%= e %></span>
                <% }); %>
                <% r.warnings.forEach(function (w) { %>
                  <span class="block text-muted">! <%= w %></span>
                <% }); %>
                <% if (!r.errors.length && !r.warnings.length) { %><span class="text-muted">—</span><% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line bg-cream/40 px-5 py-4">
      <p class="text-xs text-muted">
        <% if (a.counts.create + a.counts.update === 0) { %>
          Nothing importable in this file — fix the errors above and preview again.
        <% } else { %>
          <%= a.counts.create + a.counts.update %> product<%= (a.counts.create + a.counts.update) === 1 ? '' : 's' %> will be written.
          <%= a.mode === 'replace' ? 'The current ' + a.existingCount + ' products will be discarded.' : 'Existing products stay untouched.' %>
          A backup is written first.
        <% } %>
      </p>

      <% if (a.counts.create + a.counts.update > 0) { %>
        <form hx-post="/admin/import/commit" hx-target="#import-result" hx-swap="innerHTML">
          <input type="hidden" name="payload" value="<%= payload %>">
          <input type="hidden" name="format" value="<%= a.format %>">
          <input type="hidden" name="mode" value="<%= a.mode %>">
          <% if (typeof adminToken !== 'undefined' && adminToken) { %>
            <input type="hidden" name="token" value="<%= adminToken %>">
          <% } %>
          <button type="submit" class="bg-maroon px-7 py-3.5 text-[11px] uppercase tracking-luxe text-ivory transition hover:bg-maroonDark">
            <span class="htmx-hide-on-request">Import <%= a.counts.create + a.counts.update %> product<%= (a.counts.create + a.counts.update) === 1 ? '' : 's' %></span>
            <span class="htmx-show-on-request">Writing…</span>
          </button>
        </form>
      <% } %>
    </div>
  </div>

<% } %>
