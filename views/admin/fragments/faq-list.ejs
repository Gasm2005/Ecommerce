<% if (!aeo.faqs.length) { %>
  <p class="text-[12.5px] text-muted">No FAQs yet. Answer engines quote these more than any other copy on the site.</p>
<% } %>
<ul class="space-y-3">
  <% aeo.faqs.forEach(function (f) { %>
    <li class="flex items-start gap-3">
      <span class="min-w-0 flex-1">
        <span class="block text-[12.5px] text-ink"><%= f.q %></span>
        <span class="mt-0.5 block text-[11.5px] leading-relaxed text-muted"><%= f.a %></span>
        <span class="mt-1 inline-block pill pill-info"><%= f.scope === 'global' ? 'Site-wide' : f.scope %></span>
      </span>
      <button class="shrink-0 text-[10.5px] uppercase tracking-[0.12em] text-critical"
              hx-post="/admin/marketing/faq/<%= f.id %>/delete" hx-target="#faq-list" hx-swap="innerHTML"
              hx-vals='<%- JSON.stringify({ token: adminToken || undefined }) %>'>Delete</button>
    </li>
  <% }); %>
</ul>
