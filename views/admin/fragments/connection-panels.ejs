<%
  /* Payments + notifications credentials. Rendered as a fragment so the "test"
     buttons can swap it back with fresh status without a page reload.
     locals: payStatus, mailStatus, cfg, secretView, deliveries */
  const maskedOr = (key) => secretView[key] || '';
%>

<div class="grid gap-3 xl:grid-cols-2">

  <!-- ============================== payments ============================== -->
  <div class="card p-4">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <h2 class="font-serif text-base">Payment gateway</h2>
      <span class="pill pill-<%= payStatus.live ? 'good' : (payStatus.provider === 'manual' ? 'info' : 'warning') %>">
        <%= payStatus.live ? payStatus.label + ' · ' + payStatus.mode : (payStatus.provider === 'manual' ? 'Not connected' : 'Keys missing') %>
      </span>
    </div>

    <p class="mt-1 text-[11.5px] leading-relaxed text-muted">
      Each store uses its own gateway account. Keys are saved to
      <code class="bg-cream px-1">data/secrets.json</code> (git-ignored, never sent to a page) or read from
      environment variables — whichever you prefer.
    </p>

    <% if (payStatus.reason) { %>
      <p class="mt-2 border border-line bg-cream/50 px-3 py-2 text-[11.5px] text-muted"><%= payStatus.reason %></p>
    <% } %>

    <form method="post" action="/admin/settings/payments<%= tokenQs %>" class="mt-3 space-y-3">
      <% if (adminToken) { %><input type="hidden" name="token" value="<%= adminToken %>"><% } %>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="adm-label" for="provider">Provider</label>
          <select id="provider" name="provider" class="adm-select">
            <% payments.PROVIDERS.forEach(function (p) { %>
              <option value="<%= p.id %>" <%= cfg.payments.provider === p.id ? 'selected' : '' %>>
                <%= p.label %><%= p.stub ? ' — not implemented' : '' %>
              </option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="adm-label" for="mode">Mode</label>
          <select id="mode" name="mode" class="adm-select">
            <option value="test" <%= cfg.payments.mode === 'test' ? 'selected' : '' %>>Test</option>
            <option value="live" <%= cfg.payments.mode === 'live' ? 'selected' : '' %>>Live</option>
          </select>
        </div>
      </div>

      <div class="border-t border-line pt-3">
        <p class="adm-label">Razorpay keys</p>
        <p class="mb-2 text-[10.5px] leading-relaxed text-muted">
          Razorpay Dashboard → Settings → API Keys. Leave a field blank to keep what's already saved.
        </p>
        <div class="space-y-2">
          <div>
            <label class="adm-label" for="razorpay_keyId">Key ID <span class="text-muted">(public)</span></label>
            <input id="razorpay_keyId" name="razorpay_keyId" class="adm-input font-mono text-[11.5px]"
                   value="<%= secretView['payments.razorpay.keyId.raw'] || '' %>" placeholder="rzp_test_…">
          </div>
          <div>
            <label class="adm-label" for="razorpay_keySecret">Key Secret</label>
            <input id="razorpay_keySecret" name="razorpay_keySecret" class="adm-input font-mono text-[11.5px]"
                   placeholder="<%= maskedOr('payments.razorpay.keySecret') || 'not saved' %>" autocomplete="off">
          </div>
          <div>
            <label class="adm-label" for="razorpay_webhookSecret">Webhook Secret <span class="text-muted">(optional)</span></label>
            <input id="razorpay_webhookSecret" name="razorpay_webhookSecret" class="adm-input font-mono text-[11.5px]"
                   placeholder="<%= maskedOr('payments.razorpay.webhookSecret') || 'not saved' %>" autocomplete="off">
            <p class="mt-1 text-[10.5px] text-muted">
              Webhook URL: <code class="bg-cream px-1"><%= origin %>/webhooks/payments</code>
            </p>
          </div>
        </div>
      </div>

      <label class="flex items-start gap-2 text-[12.5px]">
        <input type="checkbox" name="partialCodChargesAdvance" class="mt-0.5" <%= cfg.payments.partialCodChargesAdvance ? 'checked' : '' %>>
        <span>Charge the advance online for partial COD
          <span class="block text-[11px] text-muted">Off means the whole amount is collected at the door.</span>
        </span>
      </label>

      <div class="flex flex-wrap items-center gap-2">
        <button class="adm-btn adm-btn-primary">Save payment settings</button>
        <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm"
                hx-post="/admin/settings/payments/test" hx-target="#connection-panels" hx-swap="outerHTML"
                hx-vals='<%- JSON.stringify({ token: adminToken || undefined }) %>'>
          Test connection
        </button>
      </div>
    </form>

    <div class="mt-4 border-t border-line pt-3 text-[11px] leading-relaxed text-muted">
      <p class="adm-label mb-1">How the flow works</p>
      <p>
        With no gateway, orders are recorded as awaiting payment — a store can go live on COD alone.
        With Razorpay connected, the order is written <strong class="text-ink">only after</strong> the payment
        signature verifies, so an abandoned payment leaves no phantom order. Refunds issued from
        Returns go back through the gateway automatically.
      </p>
    </div>
  </div>

  <!-- ============================ notifications ============================ -->
  <div class="card p-4">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <h2 class="font-serif text-base">Email & WhatsApp</h2>
      <span class="pill pill-<%= mailStatus.ready ? (mailStatus.provider === 'log' ? 'info' : 'good') : 'warning' %>">
        <%= mailStatus.provider === 'log' ? 'Log only' : (mailStatus.ready ? mailStatus.label : 'Not configured') %>
      </span>
    </div>

    <p class="mt-1 text-[11.5px] leading-relaxed text-muted">
      Order confirmations, shipping updates and refund notices. Until a provider is set, messages are
      written to the server log — nothing is sent by accident.
    </p>

    <% if (mailStatus.missing && mailStatus.missing.length) { %>
      <p class="mt-2 border border-warning/50 bg-warning/5 px-3 py-2 text-[11.5px] text-ink">
        Missing: <%= mailStatus.missing.join(', ') %>
      </p>
    <% } %>
    <% if (mailStatus.needsFrom) { %>
      <p class="mt-2 border border-warning/50 bg-warning/5 px-3 py-2 text-[11.5px] text-ink">
        A “from” address is required before mail can go out.
      </p>
    <% } %>

    <form method="post" action="/admin/settings/notifications<%= tokenQs %>" class="mt-3 space-y-3">
      <% if (adminToken) { %><input type="hidden" name="token" value="<%= adminToken %>"><% } %>

      <div>
        <label class="adm-label" for="emailProvider">Email provider</label>
        <select id="emailProvider" name="emailProvider" class="adm-select">
          <% notifications.EMAIL_PROVIDERS.forEach(function (p) { %>
            <option value="<%= p.id %>" <%= cfg.notifications.emailProvider === p.id ? 'selected' : '' %>><%= p.label %></option>
          <% }); %>
        </select>
        <p class="mt-1 text-[10.5px] text-muted">
          <%= (notifications.EMAIL_PROVIDERS.find(function (p) { return p.id === cfg.notifications.emailProvider; }) || {}).hint %>
        </p>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div><label class="adm-label" for="fromName">From name</label><input id="fromName" name="fromName" class="adm-input" value="<%= cfg.notifications.fromName %>"></div>
        <div><label class="adm-label" for="fromEmail">From email</label><input id="fromEmail" name="fromEmail" class="adm-input" value="<%= cfg.notifications.fromEmail %>" placeholder="orders@yourdomain.com"></div>
        <div><label class="adm-label" for="replyTo">Reply-to</label><input id="replyTo" name="replyTo" class="adm-input" value="<%= cfg.notifications.replyTo %>"></div>
        <div><label class="adm-label" for="storeEmail">Store alerts to</label><input id="storeEmail" name="storeEmail" class="adm-input" value="<%= cfg.notifications.storeEmail %>"></div>
      </div>

      <!-- SMTP -->
      <div class="border-t border-line pt-3">
        <p class="adm-label">SMTP</p>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="adm-label" for="smtp_host">Host</label><input id="smtp_host" name="smtp_host" class="adm-input font-mono text-[11.5px]" value="<%= secretView['notifications.smtp.host.raw'] || '' %>" placeholder="smtp.gmail.com"></div>
          <div><label class="adm-label" for="smtp_port">Port</label><input id="smtp_port" name="smtp_port" class="adm-input font-mono text-[11.5px]" value="<%= secretView['notifications.smtp.port.raw'] || '' %>" placeholder="587"></div>
          <div><label class="adm-label" for="smtp_user">User</label><input id="smtp_user" name="smtp_user" class="adm-input font-mono text-[11.5px]" value="<%= secretView['notifications.smtp.user.raw'] || '' %>"></div>
          <div><label class="adm-label" for="smtp_pass">Password</label><input id="smtp_pass" name="smtp_pass" class="adm-input font-mono text-[11.5px]" placeholder="<%= maskedOr('notifications.smtp.pass') || 'not saved' %>" autocomplete="off"></div>
        </div>
        <p class="mt-1 text-[10.5px] text-muted">Gmail needs an App Password, not the account password.</p>
      </div>

      <!-- API providers -->
      <div class="grid grid-cols-2 gap-2 border-t border-line pt-3">
        <div>
          <label class="adm-label" for="resend_apiKey">Resend API key</label>
          <input id="resend_apiKey" name="resend_apiKey" class="adm-input font-mono text-[11.5px]" placeholder="<%= maskedOr('notifications.resend.apiKey') || 're_…' %>" autocomplete="off">
        </div>
        <div>
          <label class="adm-label" for="brevo_apiKey">Brevo API key</label>
          <input id="brevo_apiKey" name="brevo_apiKey" class="adm-input font-mono text-[11.5px]" placeholder="<%= maskedOr('notifications.brevo.apiKey') || 'xkeysib-…' %>" autocomplete="off">
        </div>
      </div>

      <!-- WhatsApp -->
      <div class="border-t border-line pt-3">
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="adm-label" for="whatsappProvider">WhatsApp</label>
            <select id="whatsappProvider" name="whatsappProvider" class="adm-select">
              <% notifications.WHATSAPP_PROVIDERS.forEach(function (p) { %>
                <option value="<%= p.id %>" <%= cfg.notifications.whatsappProvider === p.id ? 'selected' : '' %>><%= p.label %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="adm-label" for="interakt_apiKey">Interakt key</label>
            <input id="interakt_apiKey" name="interakt_apiKey" class="adm-input font-mono text-[11.5px]" placeholder="<%= maskedOr('notifications.interakt.apiKey') || 'not saved' %>" autocomplete="off">
          </div>
        </div>
      </div>

      <!-- which messages go out -->
      <div class="border-t border-line pt-3">
        <p class="adm-label">Messages to send</p>
        <div class="grid gap-1.5 sm:grid-cols-2">
          <% notifications.EVENTS.forEach(function (e) { %>
            <label class="flex items-center gap-2 text-[12px]">
              <input type="checkbox" name="event_<%= e.id %>" <%= notifications.isEnabled(e.id, config) ? 'checked' : '' %>>
              <span><%= e.label %> <span class="text-muted">→ <%= e.to %></span></span>
            </label>
          <% }); %>
        </div>
      </div>

      <div class="flex flex-wrap items-end gap-2">
        <button class="adm-btn adm-btn-primary">Save notification settings</button>
        <div class="flex items-end gap-2">
          <div>
            <label class="adm-label" for="testTo">Send a test to</label>
            <input id="testTo" name="testTo" class="adm-input w-52" placeholder="you@example.com"
                   value="<%= cfg.notifications.storeEmail || '' %>">
          </div>
          <button type="button" class="adm-btn adm-btn-ghost adm-btn-sm"
                  hx-post="/admin/settings/notifications/test" hx-target="#connection-panels" hx-swap="outerHTML"
                  hx-include="#testTo" hx-vals='<%- JSON.stringify({ token: adminToken || undefined }) %>'>
            Send test
          </button>
        </div>
      </div>
    </form>

    <% if (deliveries && deliveries.length) { %>
      <div class="mt-4 border-t border-line pt-3">
        <p class="adm-label">Recent sends</p>
        <ul class="space-y-1 text-[11px]">
          <% deliveries.slice(0, 6).forEach(function (d) { %>
            <li class="flex items-baseline justify-between gap-2">
              <span class="min-w-0 truncate <%= d.ok ? 'text-muted' : 'text-critical' %>">
                <%= d.ok ? (d.logged ? '· logged' : '✓ sent') : '✕ failed' %>
                <%= d.event %> → <%= d.to || '—' %>
                <%= d.error ? '· ' + d.error : '' %>
                <%= d.skipped ? '· ' + d.skipped : '' %>
              </span>
              <span class="shrink-0 text-muted"><%= new Date(d.at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>
  </div>
</div>
