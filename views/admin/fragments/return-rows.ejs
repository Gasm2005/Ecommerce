<% if (!rows.length) { %>
  <div class="card py-12 text-center">
    <p class="font-serif text-lg">No return requests</p>
    <p class="mt-1 text-[12.5px] text-muted">Customers raise these from <code class="bg-cream px-1">/returns</code> with their order number.</p>
  </div>
<% } %>

<div class="space-y-3">
  <% rows.forEach(function (r) { %>
    <%
      const st = returns.statusMeta(r.status);
      const order = orders.byId(r.orderId);
      const next = {
        requested: ['approved', 'rejected'],
        approved: ['received', 'rejected'],
        received: ['refunded', 'rejected'],
        refunded: [],
        rejected: ['approved']
      }[r.status] || [];
    %>
    <div class="card p-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-serif text-base"><%= r.id %></span>
            <span class="pill pill-<%= st.tone %>"><%= st.label %></span>
            <a href="/admin/orders/<%= r.orderId %><%= tokenQs %>" class="text-[11.5px] text-maroon"><%= r.orderId %></a>
            <% if (order && order.discountCode) { %>
              <span class="pill pill-info">Coupon <%= order.discountCode %></span>
            <% } %>
          </div>
          <p class="mt-1 text-[12.5px] text-muted">
            <%= r.customer.name %> · <%= r.customer.phone %>
            · raised <%= new Date(r.requestedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: '2-digit' }) %>
          </p>
        </div>
        <div class="text-right">
          <p class="text-[10px] uppercase tracking-[0.12em] text-muted"><%= r.status === 'refunded' ? 'Refunded' : 'Requested' %></p>
          <p class="font-serif text-lg"><%= money(r.status === 'refunded' ? (r.refundAmount || 0) : r.requestedAmount) %></p>
          <p class="text-[10.5px] text-muted"><%= (returns.METHODS.find(function (m) { return m.id === r.method; }) || {}).label %></p>
        </div>
      </div>

      <div class="mt-3 grid gap-3 border-t border-line pt-3 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <p class="text-[10px] uppercase tracking-[0.12em] text-gold">Reason · <%= r.reason %></p>
          <% if (r.note) { %><p class="mt-1 text-[12.5px] leading-relaxed text-muted"><%= r.note %></p><% } %>

          <ul class="mt-2 space-y-1 text-[12px]">
            <% r.items.forEach(function (it) { %>
              <li class="flex justify-between gap-3">
                <span class="min-w-0 truncate"><%= it.name %> <span class="text-muted">· <%= it.size %> · qty <%= it.qty %></span></span>
                <span class="shrink-0 text-muted"><%= money(it.lineTotal) %></span>
              </li>
            <% }); %>
          </ul>

          <% if (r.media && r.media.length) { %>
            <ul class="mt-2 flex flex-wrap gap-2">
              <% r.media.forEach(function (m) { %>
                <li>
                  <% if (m.type === 'video') { %>
                    <video src="<%= m.src %>" controls preload="metadata" class="h-20 w-16 bg-cream object-cover"></video>
                  <% } else { %>
                    <a href="<%= m.src %>" target="_blank" rel="noopener"><img src="<%= m.thumb || m.src %>" alt="" loading="lazy" class="h-20 w-16 bg-cream object-cover"></a>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>

        <div>
          <ol class="space-y-1 text-[11px] text-muted">
            <% (r.timeline || []).slice().reverse().slice(0, 4).forEach(function (t) { %>
              <li><%= new Date(t.at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %> — <%= t.label %></li>
            <% }); %>
          </ol>
        </div>
      </div>

      <!-- actions -->
      <div class="mt-3 flex flex-wrap items-end gap-2 border-t border-line pt-3">
        <% next.forEach(function (target) { %>
          <% if (target === 'refunded') { %>
            <form class="flex flex-wrap items-end gap-2" hx-post="/admin/returns/<%= r.id %>/status" hx-target="#return-rows" hx-swap="innerHTML">
              <% if (adminToken) { %><input type="hidden" name="token" value="<%= adminToken %>"><% } %>
              <input type="hidden" name="status" value="refunded">
              <input type="hidden" name="q" value="<%= filters.q %>">
              <div>
                <label class="adm-label" for="amount-<%= r.id %>">Refund amount</label>
                <input id="amount-<%= r.id %>" name="amount" class="adm-input w-28" value="<%= r.requestedAmount %>">
              </div>
              <button class="adm-btn adm-btn-primary adm-btn-sm">Mark refunded</button>
              <span class="self-center text-[10.5px] text-muted">Order flips to returned; the amount leaves net sales.</span>
            </form>
          <% } else { %>
            <button class="adm-btn adm-btn-sm <%= target === 'rejected' ? 'adm-btn-danger' : '' %>"
                    hx-post="/admin/returns/<%= r.id %>/status" hx-target="#return-rows" hx-swap="innerHTML"
                    hx-vals='<%- JSON.stringify({ status: target, token: adminToken || undefined, q: filters.q || undefined }) %>'>
              Mark <%= returns.statusMeta(target).label.toLowerCase() %>
            </button>
          <% } %>
        <% }); %>

        <button class="adm-btn adm-btn-danger adm-btn-sm ml-auto"
                hx-post="/admin/returns/<%= r.id %>/delete" hx-target="#return-rows" hx-swap="innerHTML" hx-trigger="confirmed"
                hx-vals='<%- JSON.stringify({ token: adminToken || undefined, q: filters.q || undefined }) %>'
                data-confirm="<%= r.id %> will be removed. If it was already refunded, the order keeps its refund."
                data-confirm-title="Delete request?" data-confirm-cta="Delete">Delete</button>
      </div>
    </div>
  <% }); %>
</div>
