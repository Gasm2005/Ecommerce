<div class="space-y-3">
  <div class="card p-4">
    <div class="flex items-baseline justify-between">
      <h2 class="font-serif text-base">Health</h2>
      <span class="font-serif text-2xl"><%= Math.round(audit.score) %><span class="text-[12px] text-muted">/100</span></span>
    </div>

    <div class="mt-3 h-[7px] w-full bg-cream">
      <div class="h-full" style="width: <%= Math.round(audit.score) %>%; background: <%= audit.score >= 80 ? '#0ca30c' : (audit.score >= 55 ? '#fab219' : '#d03b3b') %>"></div>
    </div>

    <div class="mt-3 grid grid-cols-3 gap-2 text-center">
      <div><p class="font-serif text-lg text-critical"><%= audit.counts.critical %></p><p class="text-[9.5px] uppercase tracking-[0.1em] text-muted">Critical</p></div>
      <div><p class="font-serif text-lg" style="color:#8a6206"><%= audit.counts.warning %></p><p class="text-[9.5px] uppercase tracking-[0.1em] text-muted">Warnings</p></div>
      <div><p class="font-serif text-lg text-muted"><%= audit.counts.info %></p><p class="text-[9.5px] uppercase tracking-[0.1em] text-muted">Notes</p></div>
    </div>

    <dl class="mt-4 space-y-1.5 border-t border-line pt-3 text-[11.5px]">
      <div class="flex justify-between"><dt class="text-muted">Products</dt><dd><%= products.length %></dd></div>
      <div class="flex justify-between"><dt class="text-muted">FAQs</dt><dd><%= aeo.faqs.length %></dd></div>
      <div class="flex justify-between"><dt class="text-muted">Brand facts</dt><dd><%= geo.brandFacts.length %></dd></div>
      <div class="flex justify-between"><dt class="text-muted">Journal posts live</dt><dd><%= journalCount %></dd></div>
      <div class="flex justify-between"><dt class="text-muted">Indexable</dt><dd><%= seo.indexable ? 'Yes' : 'No' %></dd></div>
      <div class="flex justify-between"><dt class="text-muted">AI crawlers</dt><dd><%= geo.allowAiCrawlers ? 'Allowed' : 'Blocked' %></dd></div>
    </dl>
  </div>

  <div class="card p-4">
    <h2 class="font-serif text-base">What to fix</h2>
    <% if (!audit.issues.length) { %>
      <p class="mt-2 text-[12.5px] text-good">Nothing outstanding.</p>
    <% } %>
    <ul class="mt-3 max-h-[540px] space-y-3 overflow-y-auto pr-1">
      <% audit.issues.slice(0, 40).forEach(function (i) { %>
        <li class="border-l-2 pl-3 <%= i.severity === 'critical' ? 'border-critical' : (i.severity === 'warning' ? 'border-warning' : 'border-line') %>">
          <p class="text-[10px] uppercase tracking-[0.12em] text-muted"><%= i.area %> · <%= i.severity %></p>
          <p class="mt-0.5 text-[12.5px] text-ink"><%= i.message %></p>
          <p class="mt-0.5 text-[11.5px] leading-relaxed text-muted"><%= i.fix %></p>
        </li>
      <% }); %>
    </ul>
    <% if (audit.issues.length > 40) { %>
      <p class="mt-3 text-[11px] text-muted">+ <%= audit.issues.length - 40 %> more</p>
    <% } %>
  </div>
</div>
