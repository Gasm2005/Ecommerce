<%
  /* Gallery manager: uploads compress to WebP on arrival (see src/media.js).
     locals: p (product), error */
  const comp = media.available();
%>
<div id="product-gallery">
  <div class="mb-3 flex items-baseline justify-between">
    <h2 class="font-serif text-base">Gallery</h2>
    <span class="text-[10.5px] text-muted"><%= p.images.length %> image<%= p.images.length === 1 ? '' : 's' %></span>
  </div>

  <% if (error) { %>
    <p class="mb-3 border border-critical/40 bg-critical/5 px-3 py-2 text-[11.5px] text-critical"><%= error %></p>
  <% } %>

  <div class="grid grid-cols-3 gap-2">
    <% p.images.forEach(function (img) { %>
      <div class="group relative">
        <img src="<%= img.startsWith('/static/uploads/') ? img.replace(/\.webp$/, '-thumb.webp') : img %>"
             onerror="this.src='<%= img %>'" alt="" loading="lazy"
             class="aspect-[3/4] w-full bg-cream object-cover">
        <button class="absolute right-1 top-1 flex h-5 w-5 items-center justify-center bg-panel/90 text-[13px] leading-none text-ink opacity-0 transition group-hover:opacity-100 hover:bg-critical hover:text-white"
                hx-post="/admin/products/<%= p.id %>/images/remove" hx-target="#product-gallery" hx-swap="outerHTML"
                hx-vals='<%- JSON.stringify({ src: img, token: adminToken || undefined }) %>'
                aria-label="Remove image">&times;</button>
        <% if (img.startsWith('/static/uploads/')) { %>
          <span class="absolute bottom-1 left-1 bg-ink/70 px-1 text-[8px] uppercase tracking-[0.1em] text-ivory">webp</span>
        <% } %>
      </div>
    <% }); %>
  </div>

  <form class="mt-3" hx-post="/admin/products/<%= p.id %>/images" hx-target="#product-gallery" hx-swap="outerHTML"
        hx-encoding="multipart/form-data" hx-indicator="#gallery-busy" hx-on::after-request="this.reset()">
    <% if (adminToken) { %><input type="hidden" name="token" value="<%= adminToken %>"><% } %>
    <label class="flex cursor-pointer items-center justify-between gap-3 border border-dashed border-line px-3 py-3 text-left transition hover:border-maroon">
      <span>
        <span class="block text-[10.5px] uppercase tracking-[0.12em] text-ink">Upload images</span>
        <span class="block text-[10.5px] text-muted">
          <% if (comp.images) { %>
            Auto-converted to WebP, max <%= comp.settings.imageMaxEdge %>px, thumbnails generated
          <% } else { %>
            Compression unavailable — files are stored as uploaded
          <% } %>
        </span>
      </span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="shrink-0 text-gold"><path d="M12 16V4m0 0L8 8m4-4 4 4"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
      <input type="file" name="media" multiple accept="image/*,video/mp4,video/webm,video/quicktime"
             class="hidden" onchange="htmx.trigger(this.form, 'submit')">
    </label>
  </form>

  <div id="gallery-busy" class="htmx-indicator mt-2 flex items-center gap-2 text-[11px] text-muted">
    <svg class="animate-spin text-maroon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a9 9 0 1 0 9 9" stroke-linecap="round"/></svg>
    Compressing…
  </div>
</div>
