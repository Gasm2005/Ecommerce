<%- include('./partials/open', { active: 'dashboard', adminTitle: 'Dashboard', adminSubtitle: config.brand.name + ' · ' + orders.all().length + ' orders on record', adminActions: null }) %>

<% if (typeof mailHealth !== 'undefined' && mailHealth && mailHealth.broken) { %>
  <!-- The one failure a shop cannot see for itself: mail that stopped arriving while
       the settings still look correct. Every order taken meanwhile is a customer
       wondering whether it went through. -->
  <div class="card mb-4 border-l-2 border-l-maroon p-4">
    <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
      <div>
        <h2 class="font-serif text-base text-maroon">Order confirmations are not going out</h2>
        <p class="mt-1 text-[12.5px] leading-relaxed text-muted">
          The last <strong class="text-ink"><%= mailHealth.consecutiveFailures %></strong> emails failed:
          <span class="text-ink"><%= mailHealth.reason %></span>.
          <% if (mailHealth.lastOk) { %>
            The last one that did arrive was
            <%= new Date(mailHealth.lastOk.at).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }) %>.
          <% } %>
          Customers are still ordering — they are just not hearing back.
        </p>
      </div>
      <a href="/admin/marketing<%= tokenQs %>" class="shrink-0 border border-maroon px-4 py-2 text-[10px] uppercase tracking-luxe text-maroon transition hover:bg-maroon hover:text-ivory">
        Check email settings
      </a>
    </div>
  </div>
<% } %>

<!-- range picker: presets plus an explicit from/to, so a campaign window
     (say the 5 days after an influencer post) can be measured directly -->
<form hx-get="/admin" hx-target="#dash" hx-swap="innerHTML" data-auto-submit
      class="card mb-4 flex flex-wrap items-end gap-x-2 gap-y-3 p-3">
  <% if (adminToken) { %><input type="hidden" name="token" value="<%= adminToken %>"><% } %>

  <div class="flex flex-wrap items-center gap-2">
    <% analytics.RANGES.forEach(function (r) { %>
      <label class="cursor-pointer">
        <input type="radio" name="range" value="<%= r.id %>" class="peer sr-only"
               <%= (s.range.id === r.id && !s.range.custom) ? 'checked' : '' %>
               onclick="this.form.querySelectorAll('input[type=date]').forEach(function(d){d.value='';})">
        <span class="block border border-line bg-panel px-3 py-1.5 text-[10.5px] uppercase tracking-[0.12em] text-muted transition peer-checked:border-maroon peer-checked:bg-maroon peer-checked:text-ivory"><%= r.label %></span>
      </label>
    <% }); %>
  </div>

  <div class="ml-auto flex flex-wrap items-end gap-2 border-l border-line pl-3">
    <div>
      <label class="adm-label" for="from">From</label>
      <input id="from" type="date" name="from" value="<%= s.range.custom ? s.from.toISOString().slice(0,10) : '' %>" class="adm-input">
    </div>
    <div>
      <label class="adm-label" for="to">To</label>
      <input id="to" type="date" name="to" value="<%= s.range.custom ? s.to.toISOString().slice(0,10) : '' %>" class="adm-input">
    </div>
    <% if (s.range.custom) { %>
      <a href="/admin<%= tokenQs %>" class="adm-btn adm-btn-ghost adm-btn-sm mb-[1px]">Clear</a>
    <% } %>
  </div>
</form>

<div id="dash" class="adm-swap">
  <%- include('./fragments/dashboard-body') %>
</div>

<%- include('./partials/close') %>
