<%- include('./partials/open', {
  active: 'journal',
  adminTitle: 'Journal',
  adminSubtitle: posts.length + ' posts · ' + posts.filter(function (p) { return p.status === 'published'; }).length + ' published',
  adminActions: '<a href="/admin/journal/new' + tokenQs + '" class="adm-btn adm-btn-primary adm-btn-sm">Write a post</a>'
    + '<a href="/journal" target="_blank" class="adm-btn adm-btn-ghost adm-btn-sm">View journal</a>'
}) %>

<div class="grid gap-3 xl:grid-cols-4">
  <div class="xl:col-span-3">
    <div id="journal-rows" class="adm-swap">
      <%- include('./fragments/journal-rows') %>
    </div>
  </div>

  <aside class="space-y-3">
    <div class="card p-4">
      <h2 class="font-serif text-base">Why the journal matters</h2>
      <p class="mt-2 text-[11.5px] leading-relaxed text-muted">
        Long-form guides are what search and answer engines quote. Each post is indexed, added to
        <code class="bg-cream px-1">sitemap.xml</code>, listed in <code class="bg-cream px-1">llms.txt</code>
        and marked up as <code class="bg-cream px-1">Article</code> structured data.
      </p>
      <a href="/admin/marketing<%= tokenQs %>" class="mt-3 inline-block text-[10.5px] uppercase tracking-[0.12em] text-maroon">Marketing → SEO/AEO/GEO</a>
    </div>

    <% if (tags.length) { %>
      <div class="card p-4">
        <p class="adm-label">Tags in use</p>
        <div class="flex flex-wrap gap-1.5">
          <% tags.forEach(function (t) { %>
            <span class="border border-line px-2 py-1 text-[11px] text-muted"><%= t.tag %> <span class="text-ink"><%= t.count %></span></span>
          <% }); %>
        </div>
      </div>
    <% } %>
  </aside>
</div>

<%- include('./partials/close') %>
