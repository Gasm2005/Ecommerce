<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Unauthorised · <%= config.brand.name %> Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="flex min-h-screen items-center justify-center bg-[#F7F4EE] font-sans text-[#17130f]">
  <div class="max-w-sm border border-[#e3d8c6] bg-white p-8 text-center">
    <p class="text-[10px] uppercase tracking-[0.18em] text-[#a98436]">Admin</p>
    <h1 class="mt-3 font-serif text-2xl">Token required</h1>
    <p class="mt-3 text-sm leading-relaxed text-[#77706a]">
      This store runs with <code class="bg-[#f3ebde] px-1">ADMIN_TOKEN</code> set. Append
      <code class="bg-[#f3ebde] px-1">?token=…</code> to the URL to continue.
    </p>
    <a href="/" class="mt-6 inline-block border border-[#6b1b2b] px-6 py-3 text-[11px] uppercase tracking-[0.16em] text-[#6b1b2b]">Back to storefront</a>
  </div>
</body>
</html>
