</main>

<!-- Desktop gets the full editorial footer; phone + tablet get a compact
     app-style one (socials, key links, support) above the bottom tab bar. -->
<div class="hidden lg:block">
  <%- include(view('partials/footer')) %>
</div>
<%- include(view('partials/app-footer')) %>

<%- include(view('partials/app-shell')) %>

<!-- Asks once, on a first visit, only when the shop has more than one section. -->
<%- include(view('partials/audience-gate')) %>

<!-- ========================= cart drawer (right) ========================= -->
<div x-cloak x-show="$store.ui.cart" class="fixed inset-0 z-[90]" role="dialog" aria-modal="true" aria-label="Shopping bag">
  <div x-show="$store.ui.cart" x-transition.opacity.duration.200ms
       @click="$store.ui.cart = false" class="absolute inset-0 bg-ink/45"></div>
  <aside x-show="$store.ui.cart"
         x-transition:enter="transition ease-out duration-300" x-transition:enter-start="translate-x-full"
         x-transition:leave="transition ease-in duration-200" x-transition:leave-end="translate-x-full"
         class="absolute right-0 top-0 flex h-full w-full max-w-[26rem] flex-col bg-ivory shadow-2xl">
    <div id="cart-panel" class="flex h-full flex-col">
      <%- include(view('fragments/cart-drawer'), { justAdded: null }) %>
    </div>
  </aside>
</div>

<!-- ========================= quick view modal ========================= -->
<div x-cloak x-show="$store.ui.quick" class="fixed inset-0 z-[95] flex items-end justify-center sm:items-center" role="dialog" aria-modal="true" aria-label="Quick view">
  <div x-show="$store.ui.quick" x-transition.opacity.duration.200ms @click="$store.ui.quick = false" class="absolute inset-0 bg-ink/50"></div>
  <div x-show="$store.ui.quick"
       x-transition:enter="transition ease-out duration-250" x-transition:enter-start="opacity-0 translate-y-6 sm:scale-95"
       x-transition:leave="transition ease-in duration-150" x-transition:leave-end="opacity-0"
       class="relative max-h-[92vh] w-full max-w-4xl overflow-y-auto bg-ivory shadow-2xl">
    <button @click="$store.ui.quick = false" class="absolute right-4 top-3 z-10 text-2xl leading-none text-muted hover:text-maroon" aria-label="Close">&times;</button>
    <div id="quick-loading" class="htmx-indicator absolute inset-0 z-[5] bg-ivory/70"></div>
    <div id="quick-body">
      <div class="grid gap-6 p-6 sm:grid-cols-2">
        <div class="skeleton aspect-[3/4]"></div>
        <div class="space-y-3 pt-6">
          <div class="skeleton h-7 w-3/4"></div><div class="skeleton h-4 w-1/2"></div>
          <div class="skeleton h-5 w-1/3"></div><div class="skeleton h-24 w-full"></div>
          <div class="skeleton h-12 w-full"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================= toasts ========================= -->
<div id="toast-stack" class="pointer-events-none fixed bottom-6 left-1/2 z-[120] flex w-[92%] max-w-sm -translate-x-1/2 flex-col gap-2 sm:left-auto sm:right-6 sm:translate-x-0"></div>

</body>
</html>
