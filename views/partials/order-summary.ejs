<% const c = cartSummary; %>
<div id="order-summary" class="border border-line bg-cream/40 p-4">
  <h2 class="font-serif text-lg">Order summary <span class="text-[15px] text-muted">(<%= c.count %>)</span></h2>

  <ul class="mt-3 divide-y divide-line/70">
    <% c.lines.forEach(function (l) { %>
      <li class="flex gap-3 py-2.5">
        <img loading="lazy" src="<%= l.product.images[0] %>" alt="<%= l.product.name %>" class="h-16 w-11 shrink-0 object-cover">
        <div class="min-w-0 flex-1 text-[15px]">
          <p class="truncate font-serif"><%= l.product.name %></p>
          <p class="text-[13px] text-muted"><%= l.size %><%= l.color ? ' · ' + l.color : '' %> · Qty <%= l.qty %></p>
          <p class="mt-0.5"><%= money(l.lineTotal) %></p>
        </div>
      </li>
    <% }); %>
  </ul>

  <!-- Coupon: same engine as the drawer, so a code applied there carries through.
       Collapsed by default — an empty box next to the total invites second
       thoughts and costs vertical space the CTA needs. -->
  <div class="mt-3 border-t border-line pt-3" x-data="{ open: <%= c.discountCode || c.discountError ? 'true' : 'false' %> }">
    <% if (c.discountCode) { %>
      <div class="flex items-center justify-between gap-2">
        <p class="text-[13px]">
          <span class="border border-gold/60 bg-gold/10 px-2 py-1 font-mono text-[13.5px]"><%= c.discountCode %></span>
          <span class="ml-2 text-maroon">− <%= money(c.discount) %></span>
        </p>
        <button hx-post="/cart/coupon/remove" hx-swap="none"
                hx-on:htmx:after-request="window.location.reload()"
                class="text-[10px] uppercase tracking-[0.14em] text-muted hover:text-maroon">Remove</button>
      </div>
    <% } else { %>
      <button type="button" x-show="!open" @click="open = true"
              class="text-[10px] uppercase tracking-[0.14em] text-muted underline underline-offset-4 hover:text-maroon">
        Have a coupon?
      </button>
      <form x-show="open" x-cloak hx-post="/cart/coupon" hx-swap="none"
            hx-on:htmx:after-request="window.location.reload()" class="flex gap-2">
        <input name="code" placeholder="Coupon code" autocomplete="off"
               class="min-w-0 flex-1 border border-line bg-ivory px-3 py-2 text-[13px] uppercase tracking-[0.08em] placeholder:normal-case placeholder:tracking-normal placeholder:text-muted focus:border-maroon focus:outline-none">
        <button class="shrink-0 border border-ink px-3 py-2 text-[10px] uppercase tracking-[0.14em] transition hover:border-maroon hover:text-maroon">Apply</button>
      </form>
    <% } %>
    <% if (c.discountError) { %><p class="mt-2 text-[13.5px] text-maroon"><%= c.discountError %></p><% } %>
  </div>

  <%
    /* Price details, in the order a shopper reads them: what the pieces cost, what
       came off, what delivery adds, then the one number they will pay.

       Two rules this panel keeps:
       · Nothing appears at checkout that wasn't visible on the product page. The
         only line that can grow the total is delivery, and it is always shown —
         as "Free" with the original charge struck through when it is waived,
         so the saving is visible rather than silently absorbed.
       · GST is inside the price, never added. It is disclosed at the bottom
         because the customer is entitled to know, not because they owe it.       */
    const listTotal = c.subtotal + c.savings;
    const totalSaved = c.savings + (c.discount || 0)
      + ((config.shipping || {}).standardCharge && !c.shipping ? (config.shipping || {}).standardCharge : 0);
  %>
  <dl class="mt-3 space-y-1.5 border-t border-line pt-3 text-[15px]">
    <div class="flex justify-between">
      <dt class="text-muted">Price (<%= c.count %> item<%= c.count === 1 ? '' : 's' %>)</dt>
      <dd><%= money(listTotal) %></dd>
    </div>
    <% if (c.savings > 0) { %>
      <div class="flex justify-between"><dt class="text-muted">Discount</dt><dd class="text-maroon">− <%= money(c.savings) %></dd></div>
    <% } %>
    <% if (c.discount > 0) { %>
      <div class="flex justify-between"><dt class="text-muted">Coupon <%= c.discountCode %></dt><dd class="text-maroon">− <%= money(c.discount) %></dd></div>
    <% } %>
    <div class="flex justify-between">
      <dt class="text-muted"><%= c.deliveryTitle ? c.deliveryTitle + ' delivery' : 'Delivery' %></dt>
      <dd>
        <% if (c.shipping) { %>
          <%= money(c.shipping) %>
        <% } else if ((config.shipping || {}).standardCharge) { %>
          <span class="text-muted line-through"><%= money(config.shipping.standardCharge) %></span>
          <span class="ml-1 text-gold">Free</span>
        <% } else { %>
          <span class="text-gold">Free</span>
        <% } %>
      </dd>
    </div>
    <% if (c.giftWrapCharge) { %>
      <div class="flex justify-between"><dt class="text-muted">Gift packaging</dt><dd><%= money(c.giftWrapCharge) %></dd></div>
    <% } %>

    <div class="flex justify-between border-t border-line pt-2 text-base">
      <dt class="font-serif">Total payable</dt><dd class="font-serif"><%= money(c.total) %></dd>
    </div>
    <% if (c.tax) { %>
      <div class="flex justify-between pt-0.5 text-[13.5px]">
        <dt class="text-muted">Includes GST</dt><dd class="text-muted"><%= money(c.tax) %></dd>
      </div>
    <% } %>
  </dl>

  <% if (totalSaved > 0) { %>
    <p class="mt-3 border-t border-line pt-3 text-[13px] text-gold">
      You save <%= money(totalSaved) %> on this order
    </p>
  <% } %>

  <div class="mt-3 flex items-center gap-2 border-t border-line pt-3 text-[10px] uppercase tracking-[0.14em] text-muted">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3 5 6v6c0 4 3 7 7 9 4-2 7-5 7-9V6l-7-3Z"/></svg>
    Secure encrypted checkout
  </div>
</div>
