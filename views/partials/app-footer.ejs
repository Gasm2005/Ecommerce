<%
  // Compact footer for phone + tablet: socials, the links people actually need,
  // support contacts. The full editorial footer stays desktop-only.
  const ICONS = {
    instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1.1" fill="currentColor" stroke="none"/>',
    facebook: '<path d="M14.5 8.5h2V5.7h-2.2c-2 0-3.3 1.3-3.3 3.4v1.6H9v2.8h2v6.8h3v-6.8h2.2l.4-2.8H14v-1.3c0-.6.2-.9.5-.9Z"/>',
    whatsapp: '<path d="M20 11.8a8 8 0 0 1-11.9 7L4 20l1.3-3.9A8 8 0 1 1 20 11.8Z"/><path d="M9.2 8.6c.3-.1.6 0 .8.3l.7 1.1c.1.2.1.5 0 .7l-.4.5c.5 1 1.3 1.8 2.3 2.3l.5-.4c.2-.2.5-.2.7-.1l1.2.6c.3.2.4.5.3.8-.2.6-.8 1.1-1.5 1.1-2.4-.1-5-2.7-5.2-5.1 0-.7.5-1.4 1.1-1.6Z"/>',
    pinterest: '<circle cx="12" cy="12" r="8.5"/><path d="M10.3 19c-.4-1.6.1-3 .5-4.5.3-1.1-.4-2.6.6-3.4 1.2-1 2.9-.2 3 1.2.1 1.4-.7 3.2-2 3.1"/>',
    youtube: '<rect x="3" y="6" width="18" height="12" rx="3.5"/><path d="M11 9.8l4 2.2-4 2.2V9.8Z" fill="currentColor" stroke="none"/>',
    twitter: '<path d="M4 4l7 8.5L4.5 20h2l5.5-6 4.5 6H21l-7.2-9L20 4h-2l-5 5.6L9 4H4Z"/>'
  };
  const socials = (config.footer.social || []);
  const links = (config.footer.appLinks && config.footer.appLinks.length)
    ? config.footer.appLinks
    : (config.footer.columns[1] ? config.footer.columns[1].links : []);
%>

<section class="border-t border-line bg-cream/50 px-5 pb-8 pt-9 lg:hidden">

  <div class="text-center">
    <span class="block font-serif text-xl tracking-[0.18em]"><%= config.brand.logoText %></span>
    <% if (config.brand.logoSubtext) { %>
      <span class="mt-1 block text-[9px] tracking-luxe text-gold"><%= config.brand.logoSubtext %></span>
    <% } %>
  </div>

  <!-- socials -->
  <div class="mt-5 flex justify-center gap-3">
    <% socials.forEach(function (s) { %>
      <%
        const key = String(s.label).toLowerCase().replace(/[^a-z]/g, '');
        const glyph = ICONS[key] || ICONS.instagram;
      %>
      <a href="<%= s.href %>" aria-label="<%= s.label %>" rel="noopener" target="_blank"
         class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-ivory text-ink transition active:scale-95">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><%- glyph %></svg>
      </a>
    <% }); %>
  </div>

  <!-- essential links -->
  <nav class="mt-7 grid grid-cols-2 gap-x-4 gap-y-0 border-y border-line/70">
    <% links.forEach(function (l, i) { %>
      <a href="<%= l.href %>" class="border-b border-line/50 py-3 text-[12px] text-muted <%= i >= links.length - 2 ? 'border-b-0' : '' %>"><%= l.label %></a>
    <% }); %>
  </nav>

  <!-- support -->
  <div class="mt-6 grid grid-cols-2 gap-3">
    <a href="tel:<%= config.brand.supportPhone %>"
       class="flex items-center justify-center gap-2 border border-line bg-ivory py-3 text-[11px] uppercase tracking-[0.12em] text-ink">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 4h3l2 5-2 1a10 10 0 0 0 6 6l1-2 5 2v3a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/></svg>
      Call us
    </a>
    <a href="mailto:<%= config.brand.supportEmail %>"
       class="flex items-center justify-center gap-2 border border-line bg-ivory py-3 text-[11px] uppercase tracking-[0.12em] text-ink">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
      Email
    </a>
  </div>

  <div class="mt-6 flex flex-wrap justify-center gap-1.5">
    <% config.footer.payments.forEach(function (pm) { %>
      <span class="border border-line bg-ivory px-2 py-1 text-[8px] uppercase tracking-[0.1em] text-muted"><%= pm %></span>
    <% }); %>
  </div>

  <p class="mt-5 text-center text-[10px] text-muted"><%= config.footer.copyright %></p>
</section>
