<div class="relative" x-data="{ open: false }"
     <% if (sid === 'd') { %>x-effect="if (!$store.ui.deskSearch) open = false"<% } %>
     @click.outside="open = false" @keydown.escape="open = false; $refs.q<%= sid %>.blur()">
  <form action="/search" method="get" role="search" class="relative">
    <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </span>

    <input type="search" name="q" x-ref="q<%= sid %>" id="q-<%= sid %>"
           value="<%= (typeof filters !== 'undefined' && filters.q) ? filters.q : '' %>"
           placeholder="<%= (config.copy && config.copy.searchPlaceholder) || 'Search lehengas, Banarasi sarees, mehendi…' %>"
           autocomplete="off" spellcheck="false"
           class="w-full border border-line bg-cream/50 py-3 pl-11 pr-11 text-sm text-ink placeholder:text-muted/80 focus:border-maroon focus:bg-ivory focus:outline-none lg:py-2.5"
           hx-get="/fragments/search-suggest"
           hx-trigger="keyup changed delay:300ms, focus once"
           hx-target="#suggest-<%= sid %>"
           hx-indicator="#spin-<%= sid %>"
           @focus="open = true" @input="open = true">

    <span id="spin-<%= sid %>" class="htmx-indicator absolute right-4 top-1/2 -translate-y-1/2">
      <svg class="animate-spin text-maroon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a9 9 0 1 0 9 9" stroke-linecap="round"/></svg>
    </span>
  </form>

  <!-- as-you-type results land here -->
  <div id="suggest-<%= sid %>" x-show="open" x-cloak class="absolute inset-x-0 top-full z-50 pt-2"></div>
</div>
