{
  "name": "ethnic-luxe-template",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable premium ethnic-wear e-commerce template — Express + EJS fragments + HTMX + Alpine.js + Tailwind CSS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "import": "node scripts/import-products.js",
    "seed": "node scripts/seed-demo.js",
    "test": "node --test \"test/**/*.test.js\"",
    "doctor": "node scripts/doctor.js",
    "backup": "node scripts/backup.js",
    "provision": "node scripts/provision.js",
    "theme:check": "node scripts/theme-check.js",
    "raja": "SITE_CONFIG=clients/raja-wholesale.config.json DATA_DIR=clients/raja-data THEME=raja node server.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=18"
  }
}
