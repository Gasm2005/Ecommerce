<%
  /* Raja's homepage: a compact banner, then categories, then stock.
     No full-bleed hero.

     Two reasons, and the second one matters more. A shopper here is looking for
     trousers or a saree and wants the way in, not a photograph to admire — a
     full-screen image is a scroll they have to pay for. And the photography a rack shop
     actually has is garments on hangers under tube light; blown up to 86vh that looks
     worse than no photograph at all, so the banner leans on type and colour instead and
     lets the product grid carry the images.

     The hero copy still comes from config, so the shop can change every word without
     touching this file. */
  const hero = (audience && audience.hero) || config.hero;
  const strip = (nav || []).slice(0, 8);
%>
<%- include(view('partials/document-open'), { title: null }) %>

<!-- ============================ banner ============================ -->
<section class="bg-maroon text-ivory">
  <div class="mx-auto max-w-[1600px] px-4 py-9 lg:px-8 lg:py-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <% if (hero.eyebrow) { %>
          <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-goldLight"><%= hero.eyebrow %></p>
        <% } %>
        <h1 class="mt-2 whitespace-pre-line text-[1.9rem] font-semibold leading-[1.15] sm:text-4xl lg:text-[2.75rem]"><%= hero.heading %></h1>
        <p class="mt-3 max-w-xl text-[14.5px] leading-relaxed text-ivory/85"><%= hero.body %></p>
      </div>

      <div class="flex shrink-0 flex-wrap gap-3">
        <a href="<%= hero.ctaPrimary.href %>"
           class="bg-ivory px-7 py-3.5 text-[12px] font-semibold uppercase tracking-wide text-ink transition hover:bg-goldLight"><%= hero.ctaPrimary.label %></a>
        <% if (hero.ctaSecondary && hero.ctaSecondary.label) { %>
          <a href="<%= hero.ctaSecondary.href %>"
             class="border border-ivory/50 px-7 py-3.5 text-[12px] font-semibold uppercase tracking-wide text-ivory transition hover:bg-ivory/10"><%= hero.ctaSecondary.label %></a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- ===================== categories, immediately ===================== -->
<!-- Above the fold on a phone. This is the answer to "where are the trousers?", and
     making someone scroll for it is the most expensive mistake this page could make. -->
<section class="border-b border-line bg-ivory">
  <div class="mx-auto max-w-[1600px] px-4 py-5 lg:px-8">
    <div class="-mx-1 flex snap-x snap-mandatory gap-2 overflow-x-auto pb-1 lg:grid lg:grid-cols-8 lg:gap-3 lg:overflow-visible">
      <% strip.forEach(function (item) { %>
        <a href="/category/<%= item.slug %>"
           class="group flex min-w-[7.5rem] shrink-0 snap-start flex-col items-center gap-2 border border-line px-2 py-3 text-center transition hover:border-maroon lg:min-w-0">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-cream text-[15px] font-semibold text-maroon">
            <%= String(item.label).trim().charAt(0).toUpperCase() %>
          </span>
          <span class="text-[12px] leading-snug text-ink group-hover:text-maroon"><%= item.label %></span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- ======================== what the shop wants said ======================== -->
<% if ((config.trustBadges || []).length) { %>
  <div class="border-b border-line bg-cream/50">
    <div class="mx-auto grid max-w-[1600px] grid-cols-2 divide-x divide-line lg:grid-cols-4 lg:px-8">
      <% config.trustBadges.forEach(function (b, i) { %>
        <div class="px-3 py-3.5 text-center <%= i > 1 ? 'border-t border-line lg:border-t-0' : '' %>">
          <p class="text-[11.5px] font-semibold text-ink"><%= b.title %></p>
          <p class="mt-0.5 text-[11.5px] leading-snug text-muted"><%= b.text %></p>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>

<!-- ============================== sections ============================== -->
<% (config.homeSections || []).forEach(function (section, i) { %>
  <% if (i === 0) { %>
    <%- include(view('fragments/home-section'), { section: section, index: i, lazy: false }) %>
  <% } else { %>
    <div hx-get="/fragments/home-section/<%= i %>" hx-trigger="revealed once" hx-swap="outerHTML"
         class="mx-auto max-w-[1600px] px-4 py-10 lg:px-8">
      <div class="skeleton h-6 w-48"></div>
      <div class="mt-6 grid grid-cols-2 gap-x-3 gap-y-6 sm:grid-cols-3 lg:grid-cols-5 lg:gap-4">
        <% for (let s = 0; s < 5; s++) { %>
          <div><div class="skeleton aspect-[4/5]"></div><div class="skeleton mt-2 h-4 w-1/2"></div><div class="skeleton mt-1.5 h-3 w-3/4"></div></div>
        <% } %>
      </div>
    </div>
  <% } %>
<% }); %>

<%- include(view('partials/document-close')) %>
