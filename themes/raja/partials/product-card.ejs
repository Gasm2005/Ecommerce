<%
  /* Raja's card. Price-first, dense, and loud about the discount.
     The base card puts the name in a serif above a quiet price, because a bridal
     shopper is choosing a piece. This shopper is comparing forty prices, so the
     price is the largest thing on the card and the saving is next to it.

     The contract is unchanged: same locals, same quick-view endpoint, and
     availability still comes only from variants.js. */
  const p = product;
  const eager = (typeof priority !== 'undefined') && priority;
  const hover = p.images[1] || p.images[0];

  const soldOut = !variants.anyAvailable(p);
  const openSizes = soldOut ? [] : variants.sizeAvailability(p)
    .filter(function (s) { return s.available; })
    .map(function (s) { return s.size; });
  const someGone = !soldOut && openSizes.length && openSizes.length < (p.sizes || []).length;

  const saving = p.mrp > p.price ? p.mrp - p.price : 0;
%>
<article class="group relative">
  <% if ((config.features.wishlist && hasFeature('wishlist'))) { %>
    <%- include(view('fragments/wishlist-button'), { product: p, variant: 'card' }) %>
  <% } %>

  <a href="/product/<%= p.slug %>" class="block">
    <!-- 4:5 rather than 3:4: a touch taller fits garment-on-hanger photography, which
         is what a rack shop actually has, without cropping heads off. -->
    <div class="relative aspect-[4/5] overflow-hidden bg-cream">
      <img src="<%= p.images[0] %>" alt="<%= p.name %>"
           <%= eager ? '' : 'loading="lazy"' %> decoding="async"
           class="absolute inset-0 h-full w-full object-cover transition-opacity duration-500 group-hover:opacity-0">
      <img src="<%= hover %>" alt="" aria-hidden="true" loading="lazy" decoding="async"
           class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100">

      <% if (soldOut) { %>
        <span class="absolute inset-0 z-10 flex items-center justify-center bg-ivory/75">
          <span class="bg-ink px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wide text-ivory">Sold out</span>
        </span>
      <% } %>

      <!-- The saving, as a number and not only a percentage. "₹600 off" lands harder
           than "40% off" on a ₹1,500 shirt, and this is a value shop. -->
      <% if (!soldOut && saving > 0) { %>
        <span class="absolute left-0 top-2 z-10 bg-maroon px-2 py-1 text-[10px] font-semibold text-ivory">
          <%= money(saving) %> off
        </span>
      <% } %>
      <% if (p.badge && !soldOut && !saving) { %>
        <span class="absolute left-0 top-2 z-10 bg-gold px-2 py-1 text-[10px] font-semibold uppercase text-ink"><%= p.badge %></span>
      <% } %>

      <% if (config.features.quickView) { %>
        <span class="absolute inset-x-0 bottom-0 z-10 translate-y-full opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">
          <button type="button"
                  @click.prevent.stop="$store.ui.openQuick()"
                  hx-get="/fragments/quick-view/<%= p.slug %>"
                  hx-target="#quick-body" hx-swap="innerHTML"
                  hx-indicator="#quick-loading"
                  class="w-full bg-ink/90 py-2.5 text-[11px] font-semibold uppercase tracking-wide text-ivory backdrop-blur transition hover:bg-maroon">
            Quick view
          </button>
        </span>
      <% } %>
    </div>

    <div class="pt-2">
      <!-- Price first, and biggest. Everything else on this card is a caption to it. -->
      <p class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
        <span class="text-[17px] font-semibold text-ink"><%= money(p.price) %></span>
        <% if (config.features.showMrpStrikethrough && p.mrp > p.price) { %>
          <span class="text-[13px] text-muted line-through"><%= money(p.mrp) %></span>
          <span class="text-[12px] font-semibold text-maroon"><%= p.discount %>% off</span>
        <% } %>
      </p>

      <h3 class="mt-0.5 truncate text-[13.5px] text-ink"><%= p.name %></h3>
      <p class="truncate text-[12px] text-muted"><%= p.fabric %><%= p.colors.length > 1 ? ' · ' + p.colors.length + ' colours' : '' %></p>

      <% if (someGone) { %>
        <p class="mt-1 text-[11.5px] text-maroon">Only <%= openSizes.join(', ') %> left</p>
      <% } %>
    </div>
  </a>
</article>
