<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <!-- app-like chrome when installed / opened from a phone or tablet home screen -->
  <meta name="theme-color" content="<%= config.theme.colors.ivory %>">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="<%= config.brand.name %>">
  <link rel="manifest" href="/manifest.webmanifest">
<%
  /* Per-page meta comes from the route via res.locals.seo (Marketing → SEO in
     the admin); everything falls back to the brand defaults. */
  const pageTitle = (seo && seo.title)
    ? seo.title
    : ((typeof title !== 'undefined' && title) ? title + ' · ' + config.brand.name : config.brand.name + ' · ' + config.brand.tagline);
  const pageDesc = (seo && seo.description) ? seo.description : config.brand.tagline;
%>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <% if (seo && seo.keywords) { %><meta name="keywords" content="<%= seo.keywords %>"><% } %>
  <% if (seo && seo.indexable === false) { %><meta name="robots" content="noindex, follow"><% } %>
  <link rel="canonical" href="<%= origin %><%= currentPath %>">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= config.brand.name %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:url" content="<%= origin %><%= currentPath %>">
  <% if (seo && seo.ogImage) { %>
    <meta property="og:image" content="<%= seo.ogImage.startsWith('http') ? seo.ogImage : origin + seo.ogImage %>">
  <% } %>
  <meta name="twitter:card" content="summary_large_image">

  <% (jsonLd || []).forEach(function (node) { %>
    <script type="application/ld+json"><%- JSON.stringify(node) %></script>
  <% }); %>
  <link rel="icon" href="/ph.svg?seed=<%= config.brand.name %>&w=64&h=64&label=<%= encodeURIComponent(config.brand.monogram) %>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=<%= config.theme.fonts.heading.replace(/ /g,'+') %>:ital,wght@0,400;0,500;0,600;1,400&family=<%= config.theme.fonts.body.replace(/ /g,'+') %>:wght@300;400;500;600&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: <%- JSON.stringify(config.theme.colors) %>,
          fontFamily: {
            serif: ['<%= config.theme.fonts.heading %>', 'Georgia', 'serif'],
            sans: ['<%= config.theme.fonts.body %>', 'system-ui', 'sans-serif']
          },
          borderRadius: { card: '<%= config.theme.cardRadius %>', btn: '<%= config.theme.buttonRadius %>' },
          letterSpacing: { luxe: '0.22em' }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= v %>">

  <script src="https://unpkg.com/htmx.org@1.9.12" defer></script>
  <!-- app.js and Alpine plugins must be evaluated BEFORE Alpine core boots -->
  <script src="/static/js/app.js?v=<%= v %>" defer></script>
  <script src="https://unpkg.com/@alpinejs/collapse@3.14.1/dist/cdn.min.js" defer></script>
  <script src="https://unpkg.com/alpinejs@3.14.1/dist/cdn.min.js" defer></script>
</head>
<!-- x-data on <body> makes the whole document one Alpine scope, so $store
     directives work in the header, drawers, cards and injected fragments. -->
<body x-data class="overscroll-y-none bg-ivory pb-[calc(4.4rem+env(safe-area-inset-bottom))] text-ink font-sans antialiased selection:bg-maroon selection:text-ivory lg:pb-0"
      hx-headers='{"X-Requested-With":"htmx"}'>

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[200] focus:m-3 focus:bg-maroon focus:px-4 focus:py-2 focus:text-ivory">Skip to content</a>


<%
  /* A persistent contact bar, above the shared header.
     In this trade a customer calls before they cart — a wholesale rate for twenty
     pieces is a conversation, not a checkout — so the number has to be reachable from
     every page, not buried in a footer or behind a dismissible announcement strip.

     This theme deliberately does NOT override partials/header.ejs. The header is 260
     lines carrying the mobile drawer, the mega menu, the section switcher and the
     add-to-home-screen entry; forking all of that to add a phone number would mean
     giving up every future fix made to any of it. A small partial above it costs four
     lines and keeps the header shared.

     The number comes from config, so the shop edits it in Admin → Brand and nobody
     touches this file. Blank config means the bar simply does not render. */
  const phone = String(config.brand.supportPhone || '').trim();
  const digits = phone.replace(/\D/g, '');
  // A wa.me link needs the country code; a 10-digit Indian number arrives without one.
  const wa = digits.length === 10 ? '91' + digits : digits;
%>
<% if (phone) { %>
  <div class="bg-ink text-ivory">
    <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-center gap-x-5 gap-y-1 px-4 py-1.5 text-[11.5px] lg:justify-between lg:px-8">
      <p class="text-ivory/70">
        Wholesale &amp; retail · <span class="text-ivory">Gonda</span>
      </p>
      <p class="flex items-center gap-4">
        <a href="tel:<%= digits %>" class="flex items-center gap-1.5 font-medium text-ivory transition hover:text-goldLight">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M4 4h4l2 5-2.5 1.5a12 12 0 0 0 6 6L15 14l5 2v4a16 16 0 0 1-16-16Z"/></svg>
          <%= phone %>
        </a>
        <% if (wa) { %>
          <a href="https://wa.me/<%= wa %>" target="_blank" rel="noopener"
             class="flex items-center gap-1.5 text-ivory/85 transition hover:text-goldLight">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Zm4.5-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2 0-.4.1-.5l.6-.7c.1-.2.1-.3 0-.5l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.5.1-.7.3-.7.7-.9 1.6-.6 2.6.4 1.2 1.2 2.3 2.2 3.2 1.3 1.2 2.8 1.9 4.1 2 .9.1 1.7-.2 2.2-.8.2-.3.3-.6.3-.9 0-.1 0-.2-.1-.2Z"/></svg>
            WhatsApp
          </a>
        <% } %>
      </p>
    </div>
  </div>
<% } %>

<%- include(view('partials/header')) %>

<main id="main" class="min-h-[60vh]">
