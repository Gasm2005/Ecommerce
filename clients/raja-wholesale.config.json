  },
  "shipping": {
    "freeAbove": 999,
    "standardCharge": 60,
    "estimateDaysMetro": 3,
    "estimateDaysOther": 5,
    "returnWindowDays": 7,
    "cod": {
      "_readme": "Three switches: enabled (COD at all), fullEnabled (nothing upfront — carries all the RTO risk, so off by default), partialEnabled (advance now, rest on delivery). Serviceability: either blocklists, or set pincodeMode to 'allow-list' so COD works ONLY at allowedPincodesOnly.",
      "enabled": true,
      "fullEnabled": false,
      "partialEnabled": true,
      "advanceType": "percent",
      "advancePercent": 25,
      "advanceFlat": 2000,
      "minOrder": 0,
      "maxOrder": 100000,
      "pincodeMode": "block-list",
      "blockedPincodes": [
        "110001",
        "400001"
      ],
      "blockedPrefixes": [
        "19"
      ],
      "allowedPincodesOnly": []
    },
    "methods": [
      {
        "id": "standard",
        "title": "Standard",
        "note": "{metro}-{other} working days",
        "charge": null
      },
      {
        "id": "express",
        "title": "Express",
        "note": "Priority dispatch · 2-3 working days",
        "charge": 120
      }
    ],
    "_methodsReadme": "charge:null on a method means use the standard rules (freeAbove / standardCharge). Any number is a flat charge that always applies. {metro} and {other} in a note are replaced with estimateDays.",
    "giftWrapCharge": 0,
    "zones": [
      {
        "id": "gonda",
        "label": "Gonda city",
        "prefixes": [
          "271"
        ],
        "cities": [
          "Gonda"
        ],
        "replacesDefaults": true,
        "methods": [
          {
            "id": "local-sameday",
            "title": "Same-day delivery",
            "note": "Delivered by the shop today, 6pm-9pm",
            "charge": 0,
            "fulfilment": "own",
            "cutoff": "16:00",
            "days": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat"
            ],
            "slots": [
              "6pm - 7:30pm",
              "7:30pm - 9pm"
            ],
            "maxMakeDays": 0
          },
          {
            "id": "store-pickup",
            "title": "Collect from the shop",
            "note": "Ready in 2 hours — Utraula Road, Gonda",
            "charge": 0,
            "fulfilment": "pickup",
            "maxMakeDays": 0
          }
        ]
      }
    ],
    "_zonesReadme": "Delivery options by destination. Match on prefixes / pincodes / cities. fulfilment: own = the shop delivers it themselves and it must never be handed to a courier; pickup = the customer collects; courier = normal dispatch. cutoff is store-local time, so same-day stops being offered after it. replacesDefaults:false keeps the store-wide methods available alongside the zone ones."
  },
