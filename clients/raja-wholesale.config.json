  "finance": {
    "_readme": "Every cost line the owner controls. Product prices are GST-INCLUSIVE, so tax is extracted from the price, never added. Per-SKU cost/GST on the product beats the category default, which beats these globals.",
    "gstPercentDefault": 12,
    "defaultCogsPercent": 45,
    "categoryDefaults": {
      "_readme": "Optional per-category GST % and fallback COGS %. Used when a product has no cost/gstPercent of its own.",
      "bridal": {
        "gstPercent": 12,
        "cogsPercent": 42
      },
      "lehengas": {
        "gstPercent": 12,
        "cogsPercent": 44
      },
      "sarees": {
        "gstPercent": 5,
        "cogsPercent": 48
      },
      "festive": {
        "gstPercent": 5,
        "cogsPercent": 46
      },
      "cocktail": {
        "gstPercent": 12,
        "cogsPercent": 43
      },
      "gowns": {
        "gstPercent": 12,
        "cogsPercent": 43
      }
    },
    "perOrderCosts": {
      "_readme": "Charged once per order.",
      "packaging": 120,
      "shippingCost": 140,
      "codHandling": 40
    },
    "percentCosts": {
      "_readme": "Percentages of order value.",
      "paymentGateway": 2,
      "marketplaceOrPlatform": 0,
      "returnsProvision": 1.5
    },
    "monthlyCosts": {
      "_readme": "Fixed overheads, prorated to whatever window the dashboard is showing.",
      "marketing": 120000,
      "salaries": 140000,
      "rentAndUtilities": 45000,
      "software": 12000,
      "other": 15000
    },
    "gstOnShipping": true,
    "_gstOnShippingReadme": "Shipping and gift wrap are part of a composite supply under GST, so tax is extracted from them at the principal item rate. Set false if your CA wants them shown untaxed.",
    "depreciationMonthly": 0,
    "interestMonthly": 0,
    "incomeTaxPercent": 0,
    "_belowTheLineReadme": "These sit BELOW EBITDA: depreciation, loan interest, and income tax on the profit that remains. All zero by default. Fill them and profit in hand becomes what the owner actually keeps, not what the business earned.",
    "gstSlabs": [
      {
        "maxPrice": 2500,
        "percent": 5
      },
      {
        "percent": 18
      }
    ],
    "_gstSlabsReadme": "Apparel GST is slabbed on the sale value of ONE PIECE: below maxPrice gets that percent, the entry without maxPrice is the top slab. A product with its own gstPercent overrides this. Empty the array if your client does not sell slabbed goods.",
    "tdsPercent": 1,
    "tcsPercent": 1,
    "_withholdingReadme": "TDS (income tax s.194-O) and TCS (GST s.52) are withheld by MARKETPLACES on your behalf, not on your own website sales. Both are claimed back in your returns, so they are shown as recoverable and never deducted from profit."
  },
  "reviews": {
    "_readme": "source: local | google | both. Google reviews are business-level (Places API, max 5) — per-product stars come from your own reviews, exported to Google via /feeds/product-reviews.xml. Put the API key in GOOGLE_PLACES_API_KEY, never here.",
    "source": "local",
    "googlePlaceId": "",
    "cacheMinutes": 180,
    "showStoreBadge": true,
    "merchantFeed": true,
    "requirePurchase": true,
    "allowMedia": true
  },
